@page
@model ClienteWeb.Pages.Vehiculos.IndexModel
@{
    ViewData["Title"] = "Vehículos - SIMAR";
}

<style>
    /* Unificación de estilos con el layout */
    :root {
        --simar-green: #5aad31;
        --simar-dark: #4a4a4a;
        --simar-gray-light: #f8f9fa;
        --simar-border: #e9ecef;
    }
    
    * {
        font-family: 'Inter', sans-serif;
    }
    
    /* Tarjetas mejoradas */
    .vehiculo-card {
        background: white;
        border-radius: 20px;
        transition: all 0.3s ease;
        cursor: default;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }
    
    .vehiculo-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(90, 173, 49, 0.12);
        border-color: rgba(90, 173, 49, 0.2);
    }
    
    .card-img-top {
        height: 180px;
        object-fit: cover;
        background-color: var(--simar-gray-light);
    }
    
    .badge-vehiculo {
        background: var(--simar-green);
        color: white;
        font-size: 0.7rem;
        padding: 0.3rem 0.6rem;
        border-radius: 30px;
        font-weight: 500;
    }
    
    /* Badges para tipos de residuo */
    .badge-waste-type {
        background: rgba(90, 173, 49, 0.15);
        color: var(--simar-dark);
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
        border-radius: 20px;
        font-weight: 500;
        display: inline-block;
        margin: 0.15rem;
    }
    
    /* Botones mejorados */
    .btn-simar-outline {
        background: transparent;
        border: 1px solid var(--simar-green);
        color: var(--simar-green);
        border-radius: 10px;
        padding: 0.5rem 1rem;
        transition: all 0.2s;
        font-weight: 500;
    }
    
    .btn-simar-outline:hover {
        background: var(--simar-green);
        color: white;
        transform: translateY(-2px);
    }
    
    .btn-simar-primary {
        background: var(--simar-green);
        border: none;
        color: white;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        transition: all 0.2s;
        font-weight: 500;
    }
    
    .btn-simar-primary:hover {
        background: #3d7a1f;
        transform: translateY(-2px);
    }
    
    .btn-simar-secondary {
        background: var(--simar-dark);
        border: none;
        color: white;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        transition: all 0.2s;
        font-weight: 500;
    }
    
    .btn-simar-secondary:hover {
        background: #3a3a3a;
        transform: translateY(-2px);
    }
    
    /* Barra de búsqueda */
    .search-box {
        border: 1px solid var(--simar-border);
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.2s;
    }
    
    .search-box:focus-within {
        border-color: var(--simar-green);
        box-shadow: 0 0 0 2px rgba(90, 173, 49, 0.2);
    }
    
    .search-box input {
        border: none;
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
    }
    
    .search-box input:focus {
        box-shadow: none;
    }
    
    .search-box button {
        background: white;
        border: none;
        color: var(--simar-dark);
        padding: 0.6rem 1.2rem;
    }
    
    .search-box button:hover {
        background: var(--simar-green);
        color: white;
    }
    
    /* Modales mejorados */
    .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }
    
    .modal-header {
        border-bottom: 2px solid var(--simar-green);
        background: white;
        border-radius: 20px 20px 0 0;
        padding: 1.2rem 1.5rem;
    }
    
    .modal-header .modal-title {
        color: var(--simar-dark);
        font-weight: 600;
    }
    
    .modal-header .modal-title i {
        color: var(--simar-green);
    }
    
    .modal-footer {
        border-top: 1px solid var(--simar-border);
        padding: 1rem 1.5rem;
    }
    
    /* Campos de formulario */
    .form-label {
        font-weight: 500;
        font-size: 0.85rem;
        color: var(--simar-dark);
        margin-bottom: 0.3rem;
    }
    
    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid var(--simar-border);
        padding: 0.5rem 0.8rem;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: var(--simar-green);
        box-shadow: 0 0 0 2px rgba(90, 173, 49, 0.2);
    }
    
    /* Checkbox group para tipos de residuo */
    .waste-types-group {
        background: var(--simar-gray-light);
        border-radius: 12px;
        padding: 1rem;
        max-height: 250px;
        overflow-y: auto;
        border: 1px solid var(--simar-border);
    }
    
    .waste-types-group::-webkit-scrollbar {
        width: 4px;
    }
    
    .waste-types-group::-webkit-scrollbar-track {
        background: var(--simar-border);
        border-radius: 4px;
    }
    
    .waste-types-group::-webkit-scrollbar-thumb {
        background: var(--simar-green);
        border-radius: 4px;
    }
    
    .waste-checkbox-item {
        display: flex;
        align-items: center;
        padding: 0.5rem 0.75rem;
        margin-bottom: 0.25rem;
        background: white;
        border-radius: 8px;
        transition: all 0.2s;
        cursor: pointer;
    }
    
    .waste-checkbox-item:hover {
        background: rgba(90, 173, 49, 0.05);
    }
    
    .waste-checkbox-item input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin-right: 12px;
        cursor: pointer;
        accent-color: var(--simar-green);
    }
    
    .waste-checkbox-item label {
        margin: 0;
        cursor: pointer;
        font-size: 0.85rem;
        flex: 1;
    }
    
    .waste-checkbox-item .waste-code {
        font-size: 0.7rem;
        color: var(--simar-green);
        font-weight: 600;
        background: rgba(90, 173, 49, 0.1);
        padding: 0.15rem 0.4rem;
        border-radius: 20px;
        margin-left: 0.5rem;
    }
    
    .waste-checkbox-item .waste-type-badge {
        font-size: 0.65rem;
        padding: 0.15rem 0.4rem;
        border-radius: 20px;
        margin-left: 0.5rem;
    }
    
    .waste-type-peligroso {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
    }
    
    .waste-type-especial {
        background: rgba(90, 173, 49, 0.15);
        color: var(--simar-green);
    }
    
    /* Imagen preview */
    .img-preview {
        max-height: 150px;
        border-radius: 10px;
        border: 2px solid var(--simar-border);
        padding: 5px;
        object-fit: contain;
    }
    
    /* Scroll del modal */
    .modal-scrollable {
        max-height: 65vh;
        overflow-y: auto;
        padding-right: 0.5rem;
    }
    
    .modal-scrollable::-webkit-scrollbar {
        width: 4px;
    }
    
    .modal-scrollable::-webkit-scrollbar-track {
        background: var(--simar-border);
        border-radius: 4px;
    }
    
    .modal-scrollable::-webkit-scrollbar-thumb {
        background: var(--simar-green);
        border-radius: 4px;
    }
    
    /* Dropdown personalizado */
    .dropdown-menu {
        border-radius: 12px;
        border: 1px solid var(--simar-border);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }
    
    .dropdown-item:hover {
        background: rgba(90, 173, 49, 0.1);
        color: var(--simar-green);
    }
    
    .dropdown-item.text-danger:hover {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }
    
    /* Estado vacío */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 20px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }
    
    .empty-state i {
        font-size: 4rem;
        color: var(--simar-green);
        opacity: 0.5;
        margin-bottom: 1rem;
    }
    
    /* Ajuste para que el contenido no se corte con el sidebar */
    .main-content-simar {
        overflow-x: hidden;
    }
    
    .container-fluid-custom {
        width: 100%;
        padding-right: 1rem;
        padding-left: 1rem;
    }
    
    /* Selectores de grupo */
    .group-selector {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    
    .group-selector button {
        font-size: 0.8rem;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
    }
</style>

<div class="container-fluid-custom">
    <!-- Header de la página -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-semibold" style="color: var(--simar-dark);">
                <i class="bi bi-truck-front me-2" style="color: var(--simar-green);"></i>
                Vehículos
            </h2>
            <p class="text-muted small mb-0">Gestión de la flota vehicular</p>
        </div>
        
        <button class="btn-simar-primary" data-bs-toggle="modal" data-bs-target="#modalCreate">
            <i class="bi bi-plus-lg me-2"></i>Agregar Vehículo
        </button>
    </div>
    
    <!-- Barra de búsqueda -->
    <div class="mb-4">
        <form method="get" class="d-flex flex-column flex-sm-row gap-2">
            <div class="search-box flex-grow-1">
                <div class="d-flex">
                    <input type="text" name="Search" class="form-control" placeholder="Buscar por marca, modelo, placas, tipo de residuo..." value="@Model.Search">
                    <button type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a asp-page="Index" class="btn-simar-outline text-center" style="min-width: 100px;">
                    <i class="bi bi-x-circle me-1"></i>Limpiar
                </a>
            }
        </form>
    </div>
    
    <!-- Listado de vehículos -->
    @if (!Model.Vehiculos.Any())
    {
        <div class="empty-state">
            <i class="bi bi-truck-front"></i>
            <h4 class="text-secondary">No hay vehículos registrados</h4>
            <p class="text-muted">Comienza agregando tu primer vehículo</p>
            <button class="btn-simar-primary mt-3" data-bs-toggle="modal" data-bs-target="#modalCreate">
                <i class="bi bi-plus-lg"></i> Agregar Vehículo
            </button>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Vehiculos)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="vehiculo-card h-100">
                        <div class="position-relative">
                            <!-- Imagen -->
                            <img src="@(item.FotoBase64 != null ? $"data:image/jpeg;base64,{item.FotoBase64}" : "/images/vehiculos/default-truck.jpg")"
                                 alt="@item.Marca @item.Modelo"
                                 class="card-img-top"
                                 onerror="this.onerror=null; this.src='https://placehold.co/300x180/e9ecef/5aad31?text=SIN+IMAGEN'; this.style.backgroundColor='#f8f9fa';" 
                                 loading="lazy" />
                            
                            <!-- Número económico -->
                            @if (!string.IsNullOrEmpty(item.NumeroEconomico))
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge-vehiculo">
                                    <i class="bi bi-123 me-1"></i> @item.NumeroEconomico
                                </span>
                            }
                            
                            <!-- Botón de opciones -->
                            <div class="position-absolute top-0 end-0 m-2">
                                <div class="dropdown">
                                    <button class="btn btn-light btn-sm rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown" style="width: 32px; height: 32px;">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <button class="dropdown-item btn-edit" 
                                                    data-id="@item.Id"
                                                    data-marca="@item.Marca"
                                                    data-modelo="@item.Modelo"
                                                    data-peso="@item.PesoToneladas"
                                                    data-licencia="@item.LicenciaRequerida"
                                                    data-tiposresiduo='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.TiposResiduo))'
                                                    data-tipogasolina="@item.TipoGasolina"
                                                    data-placas="@item.Placas"
                                                    data-numeroeconomico="@item.NumeroEconomico"
                                                    data-anio="@item.Anio"
                                                    data-color="@item.Color"
                                                    data-descripcion="@item.Descripcion">
                                                <i class="bi bi-pencil me-2"></i> Editar
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item btn-details"
                                                    data-id="@item.Id"
                                                    data-marca="@item.Marca"
                                                    data-modelo="@item.Modelo"
                                                    data-peso="@item.PesoToneladas"
                                                    data-licencia="@item.LicenciaRequerida"
                                                    data-tiposresiduo='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.TiposResiduo))'
                                                    data-tipogasolina="@item.TipoGasolina"
                                                    data-placas="@item.Placas"
                                                    data-numeroeconomico="@item.NumeroEconomico"
                                                    data-anio="@item.Anio"
                                                    data-color="@item.Color"
                                                    data-descripcion="@item.Descripcion"
                                                    data-foto='@item.FotoBase64'>
                                                <i class="bi bi-eye me-2"></i> Ver detalles
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button class="dropdown-item text-danger btn-delete"
                                                    data-id="@item.Id"
                                                    data-numeroeconomico="@item.NumeroEconomico"
                                                    data-marca="@item.Marca"
                                                    data-modelo="@item.Modelo"
                                                    data-placas="@item.Placas">
                                                <i class="bi bi-trash me-2"></i> Eliminar
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-3">
                            <h5 class="fw-semibold mb-2" style="color: var(--simar-dark);">
                                @item.Marca @item.Modelo
                            </h5>
                            
                            <div class="mb-2">
                                @if (item.Anio.HasValue)
                                {
                                    <div class="small mb-1">
                                        <i class="bi bi-calendar text-muted me-2"></i>
                                        <strong>Año:</strong> @item.Anio
                                    </div>
                                }
                                <div class="small mb-1">
                                    <i class="bi bi-speedometer2 text-muted me-2"></i>
                                    <strong>Peso:</strong> @(item.PesoToneladas?.ToString("N1") ?? "N/A") ton
                                </div>
                                <div class="small mb-2">
                                    <i class="bi bi-upc-scan text-muted me-2"></i>
                                    <strong>Placas:</strong> @item.Placas
                                </div>
                                <div class="mt-2">
                                    <strong class="small text-muted">Tipos de residuo:</strong>
                                    <div class="mt-1">
                                        @if (item.TiposResiduo != null && item.TiposResiduo.Any())
                                        {
                                            var tiposList = item.TiposResiduo.ToList();
                                            foreach (var residuo in tiposList.Take(2))
                                            {
                                                <span class="badge-waste-type">@residuo.Nombre</span>
                                            }
                                            if (tiposList.Count > 2)
                                            {
                                                <span class="badge-waste-type">+@(tiposList.Count - 2) más</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge-waste-type text-muted">No especificado</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="px-3 pb-3 pt-0">
                            <button class="btn-simar-outline w-100 btn-sm btn-details"
                                    data-id="@item.Id"
                                    data-marca="@item.Marca"
                                    data-modelo="@item.Modelo"
                                    data-peso="@item.PesoToneladas"
                                    data-licencia="@item.LicenciaRequerida"
                                    data-tiposresiduo='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.TiposResiduo))'
                                    data-tipogasolina="@item.TipoGasolina"
                                    data-placas="@item.Placas"
                                    data-numeroeconomico="@item.NumeroEconomico"
                                    data-anio="@item.Anio"
                                    data-color="@item.Color"
                                    data-descripcion="@item.Descripcion"
                                    data-foto='@item.FotoBase64'>
                                <i class="bi bi-arrow-right me-1"></i> Ver detalles
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ==================== MODAL CREATE ==================== -->
<div class="modal fade" id="modalCreate" tabindex="-1" aria-labelledby="modalCreateLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCreateLabel">
                    <i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Vehículo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formCreate" method="post" asp-page-handler="Create" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body modal-scrollable">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-123 me-1"></i> Número Económico</label>
                            <input type="text" name="NumeroEconomico" class="form-control" placeholder="Ej: VH-001">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-calendar me-1"></i> Año</label>
                            <input type="number" name="Anio" class="form-control" placeholder="Ej: 2020" min="1990" max="@DateTime.Now.Year">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-tag me-1"></i> Marca *</label>
                            <input type="text" name="Marca" class="form-control" placeholder="Ej: Kenworth" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-gear me-1"></i> Modelo *</label>
                            <input type="text" name="Modelo" class="form-control" placeholder="Ej: T680" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-palette me-1"></i> Color</label>
                            <input type="text" name="Color" class="form-control" placeholder="Ej: Blanco">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-upc-scan me-1"></i> Placas *</label>
                            <input type="text" name="Placas" class="form-control" placeholder="Ej: ABC-1234" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-speedometer2 me-1"></i> Peso (toneladas) *</label>
                            <input type="number" step="0.1" name="PesoToneladas" class="form-control" placeholder="Ej: 8.5" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-card-text me-1"></i> Licencia requerida *</label>
                            <select name="LicenciaRequerida" class="form-select" required>
                                <option value="">Seleccionar licencia</option>
                                <option value="A">A - Automóviles</option>
                                <option value="B">B - Camiones ligeros</option>
                                <option value="C">C - Camiones pesados</option>
                                <option value="D">D - Autobuses</option>
                                <option value="E">E - Tractocamiones</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-fuel-pump me-1"></i> Tipo de combustible *</label>
                            <select name="TipoGasolina" class="form-select" required>
                                <option value="">Seleccionar tipo</option>
                                <option value="Diesel">Diesel</option>
                                <option value="Gasolina Magna">Gasolina Magna</option>
                                <option value="Gasolina Premium">Gasolina Premium</option>
                                <option value="Gas Natural">Gas Natural</option>
                                <option value="Electrico">Eléctrico</option>
                                <option value="Hibrido">Híbrido</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-trash me-1"></i> Tipos de residuo que puede transportar</label>
                            <div class="group-selector">
                                <button type="button" class="btn-simar-outline btn-sm" id="selectAllWastes">✓ Seleccionar todos</button>
                                <button type="button" class="btn-simar-outline btn-sm" id="deselectAllWastes">✗ Deseleccionar todos</button>
                            </div>
                            <div class="waste-types-group" id="wasteTypesContainer">
                                @foreach (var tipo in Model.TiposResiduoDisponibles)
                                {
                                    <div class="waste-checkbox-item">
                                        <input type="checkbox" name="TiposResiduoIds" value="@tipo.Id" id="waste_@tipo.Id">
                                        <label for="waste_@tipo.Id">
                                            @tipo.Nombre
                                            <span class="waste-code">@tipo.CodigoCatalogo</span>
                                            <span class="waste-type-badge waste-type-@tipo.TipoResiduo.ToLower()">@tipo.TipoResiduo</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="text-muted">Selecciona uno o más tipos de residuo que este vehículo puede transportar</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-chat-text me-1"></i> Descripción</label>
                            <textarea name="Descripcion" class="form-control" rows="2" placeholder="Características adicionales del vehículo..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-image me-1"></i> Foto del vehículo</label>
                            <input type="file" name="FotoArchivo" accept="image/*" class="form-control" id="createFotoInput">
                            <div class="mt-3 text-center">
                                <img id="createFotoPreview" src="#" alt="Vista previa" class="img-preview d-none">
                            </div>
                            <small class="text-muted">Formatos: JPG, PNG. Tamaño máximo: 20MB</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-simar-outline" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-simar-primary">
                        <i class="bi bi-check-lg"></i> Registrar Vehículo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== MODAL EDIT ==================== -->
<div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEditLabel">
                    <i class="bi bi-pencil-square me-2"></i>Editar Vehículo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formEdit" method="post" asp-page-handler="Update" enctype="multipart/form-data">
                <input type="hidden" name="Id" id="editId">
                @Html.AntiForgeryToken()
                <div class="modal-body modal-scrollable">
                    <div class="text-center mb-3">
                        <p class="mb-1">Foto actual:</p>
                        <img id="editFotoActual" src="#" alt="Foto actual" class="img-preview" style="max-height: 150px;">
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-123 me-1"></i> Número Económico</label>
                            <input type="text" name="NumeroEconomico" class="form-control" id="editNumeroEconomico">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-calendar me-1"></i> Año</label>
                            <input type="number" name="Anio" class="form-control" id="editAnio" min="1990" max="@DateTime.Now.Year">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-tag me-1"></i> Marca *</label>
                            <input type="text" name="Marca" class="form-control" id="editMarca" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-gear me-1"></i> Modelo *</label>
                            <input type="text" name="Modelo" class="form-control" id="editModelo" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-palette me-1"></i> Color</label>
                            <input type="text" name="Color" class="form-control" id="editColor">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-upc-scan me-1"></i> Placas *</label>
                            <input type="text" name="Placas" class="form-control" id="editPlacas" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="bi bi-speedometer2 me-1"></i> Peso (toneladas) *</label>
                            <input type="number" step="0.1" name="PesoToneladas" class="form-control" id="editPeso" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-card-text me-1"></i> Licencia requerida *</label>
                            <select name="LicenciaRequerida" class="form-select" id="editLicencia" required>
                                <option value="">Seleccionar licencia</option>
                                <option value="A">A - Automóviles</option>
                                <option value="B">B - Camiones ligeros</option>
                                <option value="C">C - Camiones pesados</option>
                                <option value="D">D - Autobuses</option>
                                <option value="E">E - Tractocamiones</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><i class="bi bi-fuel-pump me-1"></i> Tipo de combustible *</label>
                            <select name="TipoGasolina" class="form-select" id="editTipoGasolina" required>
                                <option value="">Seleccionar tipo</option>
                                <option value="Diesel">Diesel</option>
                                <option value="Gasolina Magna">Gasolina Magna</option>
                                <option value="Gasolina Premium">Gasolina Premium</option>
                                <option value="Gas Natural">Gas Natural</option>
                                <option value="Electrico">Eléctrico</option>
                                <option value="Hibrido">Híbrido</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-trash me-1"></i> Tipos de residuo que puede transportar</label>
                            <div class="group-selector">
                                <button type="button" class="btn-simar-outline btn-sm" id="editSelectAllWastes">✓ Seleccionar todos</button>
                                <button type="button" class="btn-simar-outline btn-sm" id="editDeselectAllWastes">✗ Deseleccionar todos</button>
                            </div>
                            <div class="waste-types-group" id="editWasteTypesContainer">
                                @foreach (var tipo in Model.TiposResiduoDisponibles)
                                {
                                    <div class="waste-checkbox-item">
                                        <input type="checkbox" name="TiposResiduoIds" value="@tipo.Id" id="edit_waste_@tipo.Id">
                                        <label for="edit_waste_@tipo.Id">
                                            @tipo.Nombre
                                            <span class="waste-code">@tipo.CodigoCatalogo</span>
                                            <span class="waste-type-badge waste-type-@tipo.TipoResiduo.ToLower()">@tipo.TipoResiduo</span>
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="text-muted">Selecciona uno o más tipos de residuo que este vehículo puede transportar</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-chat-text me-1"></i> Descripción</label>
                            <textarea name="Descripcion" class="form-control" id="editDescripcion" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-image me-1"></i> Nueva foto (opcional)</label>
                            <input type="file" name="FotoArchivo" accept="image/*" class="form-control" id="editFotoInput">
                            <div class="mt-3 text-center">
                                <img id="editFotoPreview" src="#" alt="Vista previa" class="img-preview d-none">
                            </div>
                            <small class="text-muted">Dejar vacío para mantener la foto actual. Tamaño máximo: 20MB</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-simar-outline" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-simar-primary">
                        <i class="bi bi-check-lg"></i> Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==================== MODAL DETAILS ==================== -->
<div class="modal fade" id="modalDetails" tabindex="-1" aria-labelledby="modalDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetailsLabel">
                    <i class="bi bi-info-circle me-2"></i>Detalles del Vehículo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-3">
                        <img id="detailsFoto" src="#" alt="Foto del vehículo" class="img-fluid rounded border img-preview" style="max-height: 200px;">
                    </div>
                    <div class="col-md-8">
                        <h4 class="mb-3" id="detailsTitulo"></h4>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-123 me-2"></i>No. Económico:</strong> <span id="detailsNumeroEconomico"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-calendar me-2"></i>Año:</strong> <span id="detailsAnio"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-tag me-2"></i>Marca:</strong> <span id="detailsMarca"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-gear me-2"></i>Modelo:</strong> <span id="detailsModelo"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-palette me-2"></i>Color:</strong> <span id="detailsColor"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-upc-scan me-2"></i>Placas:</strong> <span id="detailsPlacas"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-speedometer2 me-2"></i>Peso:</strong> <span id="detailsPeso"></span> toneladas
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-card-text me-2"></i>Licencia:</strong> <span id="detailsLicencia"></span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-fuel-pump me-2"></i>Combustible:</strong> <span id="detailsGasolina"></span>
                            </div>
                            <div class="col-12 mb-2">
                                <strong><i class="bi bi-trash me-2"></i>Tipos de residuo:</strong>
                                <div id="detailsTiposResiduo" class="mt-1"></div>
                            </div>
                            <div class="col-12 mb-2">
                                <strong><i class="bi bi-chat-text me-2"></i>Descripción:</strong> 
                                <p id="detailsDescripcion" class="mt-1"></p>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong><i class="bi bi-hash me-2"></i>ID:</strong> <span id="detailsId"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-simar-outline" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn-simar-primary" id="btnEditFromDetails">
                    <i class="bi bi-pencil"></i> Editar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== MODAL DELETE ==================== -->
<div class="modal fade" id="modalDelete" tabindex="-1" aria-labelledby="modalDeleteLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDeleteLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3" style="background: rgba(90, 173, 49, 0.1); border: 1px solid var(--simar-green); color: var(--simar-dark);">
                    <i class="bi bi-exclamation-circle me-2"></i> Esta acción no se puede deshacer.
                </div>
                <p>¿Estás seguro de que quieres eliminar este vehículo?</p>
                <div class="card mb-3 bg-light">
                    <div class="card-body">
                        <h6 id="deleteVehiculoNombre"></h6>
                        <p class="mb-1"><strong>No. Económico:</strong> <span id="deleteNumeroEconomico"></span></p>
                        <p class="mb-1"><strong>Placas:</strong> <span id="deletePlacas"></span></p>
                        <p class="mb-0"><strong>ID:</strong> <span id="deleteId"></span></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-simar-outline" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" class="btn-simar-primary" id="confirmDelete">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let vehiculoAEliminar = null;

        // Mostrar mensajes toast
        @if (Model.SuccessMessage != null)
        {
            <text>showToast('@Model.SuccessMessage', 'success');</text>
        }
        @if (Model.ErrorMessage != null)
        {
            <text>showToast('@Model.ErrorMessage', 'error');</text>
        }

        function showToast(message, type) {
            const bgColor = type === 'success' ? '#5aad31' : '#dc3545';
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed; top: 20px; right: 20px; z-index: 9999;
                background: ${bgColor}; color: white; padding: 15px 20px;
                border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                max-width: 400px; animation: slideIn 0.3s ease;
            `;
            toast.innerHTML = message;
            document.body.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 3000);
        }

        // Preview de foto
        function setupImagePreview(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            if (input && preview) {
                input.addEventListener('change', function() {
                    if (this.files && this.files[0]) {
                        const file = this.files[0];
                        if (file.size > 20 * 1024 * 1024) {
                            showToast('La foto no puede superar los 20MB', 'error');
                            this.value = '';
                            preview.classList.add('d-none');
                            return;
                        }
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            preview.src = e.target.result;
                            preview.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);
                    } else {
                        preview.src = '#';
                        preview.classList.add('d-none');
                    }
                });
            }
        }

        setupImagePreview('createFotoInput', 'createFotoPreview');
        setupImagePreview('editFotoInput', 'editFotoPreview');

        // Funciones para seleccionar/deseleccionar todos los checkboxes
        function setupCheckboxControls(selectBtnId, deselectBtnId, containerId) {
            const selectBtn = document.getElementById(selectBtnId);
            const deselectBtn = document.getElementById(deselectBtnId);
            const container = document.getElementById(containerId);
            
            if (selectBtn) {
                selectBtn.addEventListener('click', () => {
                    const checkboxes = container.querySelectorAll('input[type="checkbox"]');
                    checkboxes.forEach(cb => cb.checked = true);
                });
            }
            
            if (deselectBtn) {
                deselectBtn.addEventListener('click', () => {
                    const checkboxes = container.querySelectorAll('input[type="checkbox"]');
                    checkboxes.forEach(cb => cb.checked = false);
                });
            }
        }

        setupCheckboxControls('selectAllWastes', 'deselectAllWastes', 'wasteTypesContainer');
        setupCheckboxControls('editSelectAllWastes', 'editDeselectAllWastes', 'editWasteTypesContainer');

        // ========== EDITAR ==========
        document.querySelectorAll('.btn-edit').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('editId').value = this.dataset.id;
                document.getElementById('editMarca').value = this.dataset.marca || '';
                document.getElementById('editModelo').value = this.dataset.modelo || '';
                document.getElementById('editPeso').value = this.dataset.peso || '';
                document.getElementById('editLicencia').value = this.dataset.licencia || '';
                document.getElementById('editTipoGasolina').value = this.dataset.tipogasolina || '';
                document.getElementById('editPlacas').value = this.dataset.placas || '';
                document.getElementById('editNumeroEconomico').value = this.dataset.numeroeconomico || '';
                document.getElementById('editAnio').value = this.dataset.anio || '';
                document.getElementById('editColor').value = this.dataset.color || '';
                document.getElementById('editDescripcion').value = this.dataset.descripcion || '';
                
                // Manejar tipos de residuo (checkboxes)
                const tiposResiduo = this.dataset.tiposresiduo ? JSON.parse(this.dataset.tiposresiduo) : [];
                const checkboxes = document.querySelectorAll('#editWasteTypesContainer input[type="checkbox"]');
                checkboxes.forEach(cb => {
                    cb.checked = tiposResiduo.some(t => t.id == cb.value);
                });
                
                // Mostrar foto actual si existe
                const fotoActual = document.getElementById('editFotoActual');
                if (this.dataset.foto && this.dataset.foto !== 'null') {
                    fotoActual.src = `data:image/jpeg;base64,${this.dataset.foto}`;
                    fotoActual.classList.remove('d-none');
                } else {
                    fotoActual.src = 'https://placehold.co/300x200/e9ecef/5aad31?text=SIN+FOTO';
                }
                
                new bootstrap.Modal(document.getElementById('modalEdit')).show();
            });
        });

        // ========== DETALLES ==========
        document.querySelectorAll('.btn-details').forEach(btn => {
            btn.addEventListener('click', function () {
                const tiposResiduo = this.dataset.tiposresiduo ? JSON.parse(this.dataset.tiposresiduo) : [];
                
                document.getElementById('detailsId').textContent = this.dataset.id;
                document.getElementById('detailsMarca').textContent = this.dataset.marca || 'N/A';
                document.getElementById('detailsModelo').textContent = this.dataset.modelo || 'N/A';
                document.getElementById('detailsTitulo').textContent = `${this.dataset.marca || ''} ${this.dataset.modelo || ''}`.trim() || 'Vehículo';
                document.getElementById('detailsNumeroEconomico').textContent = this.dataset.numeroeconomico || 'No registrado';
                document.getElementById('detailsAnio').textContent = this.dataset.anio || 'No registrado';
                document.getElementById('detailsColor').textContent = this.dataset.color || 'No registrado';
                document.getElementById('detailsPlacas').textContent = this.dataset.placas || 'No registrado';
                document.getElementById('detailsPeso').textContent = this.dataset.peso ? parseFloat(this.dataset.peso).toFixed(1) : 'N/A';
                document.getElementById('detailsLicencia').textContent = this.dataset.licencia || 'No registrado';
                document.getElementById('detailsGasolina').textContent = this.dataset.tipogasolina || 'No registrado';
                document.getElementById('detailsDescripcion').textContent = this.dataset.descripcion || 'Sin descripción';
                
                // Mostrar foto
                const foto = document.getElementById('detailsFoto');
                if (this.dataset.foto && this.dataset.foto !== 'null') {
                    foto.src = `data:image/jpeg;base64,${this.dataset.foto}`;
                } else {
                    foto.src = 'https://placehold.co/300x200/e9ecef/5aad31?text=SIN+FOTO';
                }
                
                // Mostrar tipos de residuo como badges
                const container = document.getElementById('detailsTiposResiduo');
                container.innerHTML = '';
                if (tiposResiduo.length > 0) {
                    tiposResiduo.forEach(t => {
                        const badge = document.createElement('span');
                        badge.className = `badge-waste-type me-1 mb-1`;
                        badge.innerHTML = `<strong>${t.codigoCatalogo || t.codigo || ''}</strong> - ${t.nombre}`;
                        container.appendChild(badge);
                    });
                } else {
                    container.innerHTML = '<span class="text-muted">No se han registrado tipos de residuo</span>';
                }
                
                new bootstrap.Modal(document.getElementById('modalDetails')).show();
            });
        });

        // Editar desde detalles
        document.getElementById('btnEditFromDetails')?.addEventListener('click', function() {
            const id = document.getElementById('detailsId').textContent;
            if (id && id !== 'N/A') {
                const btnEdit = document.querySelector(`.btn-edit[data-id="${id}"]`);
                if (btnEdit) btnEdit.click();
                bootstrap.Modal.getInstance(document.getElementById('modalDetails')).hide();
            }
        });

        // ========== ELIMINAR ==========
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function () {
                vehiculoAEliminar = {
                    id: this.dataset.id,
                    numeroEconomico: this.dataset.numeroeconomico || 'No especificado',
                    marca: this.dataset.marca || '',
                    modelo: this.dataset.modelo || '',
                    placas: this.dataset.placas || 'No especificadas'
                };
                
                document.getElementById('deleteId').textContent = vehiculoAEliminar.id;
                document.getElementById('deleteNumeroEconomico').textContent = vehiculoAEliminar.numeroEconomico;
                document.getElementById('deletePlacas').textContent = vehiculoAEliminar.placas;
                document.getElementById('deleteVehiculoNombre').innerHTML = 
                    `<i class="bi bi-truck me-2"></i> ${vehiculoAEliminar.marca} ${vehiculoAEliminar.modelo}`.trim();
                
                new bootstrap.Modal(document.getElementById('modalDelete')).show();
            });
        });

        // Confirmar eliminación
        document.getElementById('confirmDelete')?.addEventListener('click', function() {
            if (vehiculoAEliminar) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = `?handler=Delete&id=${vehiculoAEliminar.id}`;
                
                const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]');
                if (antiForgery) {
                    form.innerHTML += `<input type="hidden" name="__RequestVerificationToken" value="${antiForgery.value}">`;
                }
                
                document.body.appendChild(form);
                form.submit();
            }
        });
    </script>
}