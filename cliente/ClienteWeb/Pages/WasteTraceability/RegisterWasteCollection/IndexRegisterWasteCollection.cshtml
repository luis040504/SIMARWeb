@page
@model ClienteWeb.Pages.WasteTraceability.RegisterWasteCollection.IndexModel
@{
    ViewData["Title"] = "Seguimiento de Contratos y Servicios";
}

<style>
    .modal-simar {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        overflow-y: auto; /* Permite scroll vertical si la pantalla es muy pequeña */
    }
    
    .modal-content-simar {
        background: white;
        margin: 90px auto 2rem auto; /* Libera el header fijo de 70px y deja espacio abajo */
        width: 90%;
        max-width: 750px;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    
    .modal-header-simar {
        padding: 1.25rem 1.5rem;
        border-bottom: 2px solid var(--simar-green);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .modal-body-simar {
        padding: 1.5rem;
        overflow-y: auto;
    }
    
    .close-simar {
        cursor: pointer;
        font-size: 1.5rem;
    }

    .historial-item {
        border-left: 3px solid var(--simar-green);
        background: var(--simar-gray-light);
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 0 10px 10px 0;
    }
</style>

<div class="consult-container">
    @if (ViewData["MensajeError"] != null)
    {
        <div class="alert alert-@(ViewData["TipoError"] ?? "danger") alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @ViewData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-semibold mb-0" style="color: var(--simar-dark);">
                <i class="bi bi-clipboard-pulse me-2" style="color: var(--simar-green);"></i>
                Seguimiento de Contratos y Servicios
            </h2>
            <p class="text-muted small mb-0">Consulte el estado actual de sus servicios por contrato</p>
        </div>
    </div>

    <div class="table-responsive-simar">
        <table class="table-simar">
            <thead>
                <tr>
                    <th>Servicio (Manifiesto)</th>
                    <th>Fecha Servicio</th>
                    <th>Cliente</th>
                    <th>Residuo</th>
                    <th>Estado del Servicio</th>
                    <th>Contrato</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contrato in Model.Contratos)
                {
                    <tr onclick="abrirHistorial(@contrato.Id)">
                        <td>
                            @if (contrato.UltimoServicio != null)
                            {
                                <div>
                                    <span class="badge @ClienteWeb.Pages.WasteTraceability.RegisterWasteCollection.IndexModel.GetStatusClass(contrato.UltimoServicio.Status)">
                                        @ClienteWeb.Pages.WasteTraceability.RegisterWasteCollection.IndexModel.MapStatus(contrato.UltimoServicio.Status)
                                    </span>
                                    <br />
                                    <small class="text-muted">#@contrato.UltimoServicio.ManifestNumber - @(contrato.UltimoServicio.ManifestDate.HasValue ? contrato.UltimoServicio.ManifestDate.Value.ToString("dd/MM/yyyy") : "—")</small>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td>
                            @if (contrato.UltimoServicio != null)
                            {
                                <span>@contrato.UltimoServicio.ManifestDate.ToString("dd/MM/yyyy")</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td>@contrato.Cliente</td>
                        <td>
                            @if (contrato.UltimoServicio != null)
                            {
                                <span class="text-truncate d-inline-block" style="max-width: 180px;" title="@contrato.UltimoServicio.ResidueSummary">
                                    @(string.IsNullOrEmpty(contrato.UltimoServicio.ResidueSummary) ? "Sin descripción" : contrato.UltimoServicio.ResidueSummary)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Sin servicios</span>
                            }
                        </td>
                        <td onclick="event.stopPropagation()">
                            @if (contrato.UltimoServicio != null)
                            {
                                @if (Model.Rol.ToLower() != "cliente" && contrato.UltimoServicio.Status != "completado")
                                {
                                    <form method="post" action="?handler=UpdateStatus" class="d-inline-block">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="manifestId" value="@contrato.UltimoServicio.Id" />
                                        <select name="nuevoEstado" class="form-select form-select-sm d-inline-block fw-semibold" style="width: auto; padding: 0.15rem 1.5rem 0.15rem 0.5rem; font-size: 0.8rem; height: auto; border-radius: 30px; border-color: var(--simar-green);" onchange="this.form.submit()">
                                            <option value="borrador" selected="@(contrato.UltimoServicio.Status == "borrador")">Programado</option>
                                            <option value="en_transito" selected="@(contrato.UltimoServicio.Status == "en_transito")">En ruta</option>
                                            <option value="completado" selected="@(contrato.UltimoServicio.Status == "completado")">Concluido</option>
                                            <option value="cancelado" selected="@(contrato.UltimoServicio.Status == "cancelado")">Cancelado</option>
                                        </select>
                                    </form>
                                }
                                else
                                {
                                    <span class="@ClienteWeb.Pages.WasteTraceability.RegisterWasteCollection.IndexModel.GetStatusClass(contrato.UltimoServicio.Status)">
                                        @ClienteWeb.Pages.WasteTraceability.RegisterWasteCollection.IndexModel.MapStatus(contrato.UltimoServicio.Status)
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge-simar badge-simar-sin">Sin asignar</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-dark">@contrato.Folio</span>
                        </td>
                        <td>
                            <button type="button" class="action-btn ver" style="border: none;">
                                <i class="bi bi-eye"></i> Historial
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Historial -->
<div id="historialModal" class="modal-simar">
    <div class="modal-content-simar">
        <div class="modal-header-simar">
            <h2 id="modalTitle">Historial de Servicios</h2>
            <span class="close-simar" onclick="cerrarModal()">&times;</span>
        </div>
        <div class="modal-body-simar" id="modalBody">
            <!-- Cargado por JS -->
        </div>
    </div>
</div>

<script>
    const contratos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Contratos));
    const userRole = '@ViewData["Rol"]';

    function abrirHistorial(id) {
        const contrato = contratos.find(c => c.Id === id);
        if (!contrato) return;

        document.getElementById('modalTitle').innerText = `Historial de Servicios - ${contrato.Folio}`;
        const body = document.getElementById('modalBody');
        body.innerHTML = '';

        if (contrato.HistorialServicios.length === 0) {
            body.innerHTML = '<p class="text-center py-5 text-muted">No hay historial de servicios para este contrato.</p>';
        } else {
            contrato.HistorialServicios.forEach(m => {
                const item = document.createElement('div');
                item.className = 'historial-item';
                
                let statusName = mapStatus(m.Status);
                let statusClass = getStatusClass(m.Status);

                let statusSelectorHtml = '';
                if (userRole.toLowerCase() !== 'cliente') {
                    statusSelectorHtml = `
                        <div class="mt-2 pt-2 border-top">
                            <form method="post" action="?handler=UpdateStatus" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="manifestId" value="${m.Id}" />
                                <label class="small text-muted mb-0 me-1">Actualizar estado:</label>
                                <select name="nuevoEstado" class="form-select form-select-sm d-inline-block" style="width: auto; max-width: 140px; padding: 0.15rem 0.5rem; font-size: 0.8rem; height: auto;" onchange="this.form.submit()" ${m.Status === 'completado' ? 'disabled' : ''}>
                                    <option value="borrador" ${m.Status === 'borrador' ? 'selected' : ''}>Programado</option>
                                    <option value="en_transito" ${m.Status === 'en_transito' ? 'selected' : ''}>En ruta</option>
                                    <option value="completado" ${m.Status === 'completado' ? 'selected' : ''}>Concluido</option>
                                    <option value="cancelado" ${m.Status === 'cancelado' ? 'selected' : ''}>Cancelado</option>
                                </select>
                            </form>
                        </div>
                    `;
                }

                item.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">Manifiesto #${m.ManifestNumber}</h5>
                            <p class="mb-0 small text-muted"><i class="bi bi-calendar"></i> ${formatDate(m.ManifestDate)}</p>
                            <p class="mb-0 small text-muted"><i class="bi bi-recycle"></i> ${m.ResidueSummary || 'Sin descripción'}</p>
                        </div>
                        <div>
                            <span class="${statusClass}">${statusName}</span>
                        </div>
                    </div>
                    ${statusSelectorHtml}
                `;
                body.appendChild(item);
            });
        }

        document.getElementById('historialModal').style.display = 'block';
    }

    function cerrarModal() {
        document.getElementById('historialModal').style.display = 'none';
    }

    function mapStatus(status) {
        switch(status) {
            case 'borrador': return 'Programado';
            case 'en_transito': return 'En ruta';
            case 'completado': return 'Concluido';
            case 'cancelado': return 'Cancelado';
            default: return status;
        }
    }

    function getStatusClass(status) {
        switch(status) {
            case 'borrador': return 'badge-simar badge-simar-programada';
            case 'en_transito': return 'badge-simar badge-simar-enruta';
            case 'completado': return 'badge-simar badge-simar-completada';
            case 'cancelado': return 'badge-simar badge-simar-cancelada';
            default: return 'badge-simar badge-simar-sin';
        }
    }

    function formatDate(dateStr) {
        if (!dateStr) return 'N/A';
        const d = new Date(dateStr);
        return d.toLocaleDateString('es-MX');
    }

    window.onclick = function(event) {
        if (event.target == document.getElementById('historialModal')) {
            cerrarModal();
        }
    }
</script>