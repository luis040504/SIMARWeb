                                <h6 class="alert-heading fw-bold mb-1 text-warning-emphasis">⚠️ Diferencia de Montos Detectada con Logística</h6>
                                <p class="mb-0 small text-dark opacity-75">
                                    Este comprobante fue modificado durante la generación. El subtotal estimado del **@trackingSource** original era de <strong>@Model.SelectedRecord.OriginalAmount.ToString("C")</strong>, mientras que el subtotal facturado real es de <strong>@((Model.SelectedRecord.Amount / 1.16m).ToString("C") )</strong> (diferencia de **@((Math.Abs((Model.SelectedRecord.Amount / 1.16m) - Model.SelectedRecord.OriginalAmount)).ToString("C"))**).
                                </p>
                            </div>
                        </div>
                    }

                    <!-- REPRESENTACION IMPRESA DE CFDI -->
                    <div class="cfdi-container border border-2 border-dark p-4 rounded bg-white">
                        
                        <!-- HEADER / LOGO & FOLIO FISCAL -->
                        <div class="row align-items-start border-bottom border-dark pb-3 mb-3">
                            <div class="col-md-7">
                                <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: 1px;">SIMAR S.A. DE C.V.</h3>
                                <p class="mb-1 fw-bold">RFC: SIM120101XYZ</p>
                                <p class="mb-1">Av. Ruiz Cortines 1024, Col. Centro, Xalapa, Veracruz, C.P. 91000</p>
                                <p class="mb-0">Régimen Fiscal: <strong>601 - General de Ley Personas Morales</strong></p>
                            </div>
                            <div class="col-md-5">
                                <div class="border border-dark p-3 bg-light rounded text-center">
                                    <h6 class="fw-bold text-uppercase border-bottom border-dark pb-2 mb-2 text-dark">Factura Digital CFDI</h6>
                                    <p class="mb-1 text-start"><small><strong>Folio Fiscal (UUID):</strong></small><br><span class="fw-bold text-uppercase" style="font-size: 0.73rem;">@(Model.FullSelectedInvoice?.FiscalData?.Uuid ?? "00000000-0000-0000-0000-000000000000")</span></p>
                                    <p class="mb-1 text-start"><small><strong>No. Serie Certificado SAT:</strong></small> <span class="fw-bold">@(Model.FullSelectedInvoice?.FiscalData?.SatCertificateNumber ?? "00001000000504465028")</span></p>
                                    <p class="mb-1 text-start"><small><strong>Fecha y Hora Emisión:</strong></small> <span class="fw-bold">@Model.SelectedRecord.Date.ToString("yyyy-MM-dd HH:mm:ss")</span></p>
                                    <p class="mb-0 text-start"><small><strong>Efecto Comprobante:</strong></small> <span class="fw-bold">I - Ingreso (Versión 4.0)</span></p>
                                </div>
                            </div>
                        </div>

                        <!-- EMISOR Y RECEPTOR -->
                        <div class="row border-bottom border-dark pb-3 mb-3">
                            <div class="col-md-6 border-end border-dark">
                                <h6 class="fw-bold text-uppercase border-bottom border-dark pb-1 text-dark">Información del Emisor</h6>
                                <p class="mb-1"><strong>Razón Social:</strong> SIMAR S.A. DE C.V.</p>
                                <p class="mb-1"><strong>RFC:</strong> SIM120101XYZ</p>
                                <p class="mb-0"><strong>Lugar Expedición (CP):</strong> 91000</p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold text-uppercase border-bottom border-dark pb-1 text-dark">Información del Receptor</h6>
                                <p class="mb-1"><strong>Nombre o Razón Social:</strong> @Model.SelectedRecord.ClientName</p>
                                <p class="mb-1"><strong>RFC:</strong> @Model.SelectedRecord.TaxId</p>
                                <p class="mb-1"><strong>Domicilio Fiscal (CP):</strong> @(Model.SelectedRecord.PostalCode ?? "91000")</p>
                                <p class="mb-1"><strong>Régimen Fiscal Receptor:</strong> @Model.GetDisplayName_FiscalRegime(Model.SelectedRecord.FiscalRegime)</p>
                                <p class="mb-0"><strong>Uso de CFDI:</strong> @Model.GetDisplayName_CfdiUsage(Model.SelectedRecord.CfdiUsage)</p>
                            </div>
                        </div>

                        <!-- ATRIBUTOS DE PAGO -->
                        <div class="row border-bottom border-dark pb-2 mb-3 bg-light py-2">
                            <div class="col-md-4">
                                <strong>Forma de Pago:</strong> @Model.GetDisplayName_PaymentForm(Model.SelectedRecord.PaymentForm)
                            </div>
                            <div class="col-md-4">
                                <strong>Método de Pago:</strong> @Model.GetDisplayName_PaymentMethod(Model.SelectedRecord.PaymentMethod)
                            </div>
                            <div class="col-md-4">
                                <strong>Moneda:</strong> MXN - Peso Mexicano
                            </div>
                        </div>

                        <!-- CONCEPTOS TABLE -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-uppercase border-bottom border-dark pb-1 text-dark mb-3">Detalle de Conceptos Facturados</h6>
                            <table class="table table-bordered border-dark text-center align-middle" style="font-size: 0.78rem;">
                                <thead class="table-light">
                                    <tr class="border-dark">
                                        <th class="border-dark">Clave Prod/Serv</th>
                                        <th class="border-dark">No. Identificación</th>
                                        <th class="border-dark">Cantidad</th>
                                        <th class="border-dark">Clave Unidad</th>
                                        <th class="border-dark">Descripción / Residuo</th>
                                        <th class="border-dark">Valor Unitario</th>
                                        <th class="border-dark">IVA (16%)</th>
                                        <th class="border-dark">Importe</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.FullSelectedInvoice != null && Model.FullSelectedInvoice.Items != null && Model.FullSelectedInvoice.Items.Any())
                                    {
                                        foreach (var item in Model.FullSelectedInvoice.Items)
                                        {
                                            var rowIva = item.Amount * 0.16m;
                                            <tr class="border-dark">
                                                <td class="border-dark">@(item.ProductCode ?? "80141600")</td>
                                                <td class="border-dark text-truncate" style="max-width: 100px;">@(Model.SelectedRecord.ServiceId ?? "N/A")</td>
                                                <td class="border-dark">@item.Quantity</td>
                                                <td class="border-dark">@(item.UnitCode ?? "E48")</td>
                                                <td class="border-dark text-start">@item.Description</td>
                                                <td class="border-dark text-end">@item.UnitPrice.ToString("C")</td>
                                                <td class="border-dark text-end">@rowIva.ToString("C")</td>
                                                <td class="border-dark text-end">@item.Amount.ToString("C")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        var subtotalMock = Model.SelectedRecord.Amount / 1.16m;
                                        var ivaMock = subtotalMock * 0.16m;
                                        <tr class="border-dark">
                                            <td class="border-dark">@(Model.SelectedRecord.ProductCode ?? "80141600")</td>
                                            <td class="border-dark">@(Model.SelectedRecord.ServiceId ?? "N/A")</td>
                                            <td class="border-dark">1</td>
                                            <td class="border-dark">@(Model.SelectedRecord.UnitCode ?? "E48")</td>
                                            <td class="border-dark text-start">@(Model.SelectedRecord.ServiceType ?? Model.SelectedRecord.Description)</td>
                                            <td class="border-dark text-end">@subtotalMock.ToString("C")</td>
                                            <td class="border-dark text-end">@ivaMock.ToString("C")</td>
                                            <td class="border-dark text-end">@subtotalMock.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- TOTALES -->
                        <div class="row mb-4 justify-content-end">
                            <div class="col-md-5">
                                <div class="border border-dark p-3 rounded bg-light">
                                    <div class="d-flex justify-content-between mb-1 border-bottom border-secondary pb-1">
                                        <span><strong>Subtotal:</strong></span>
                                        <span>@((Model.SelectedRecord.Amount / 1.16m).ToString("C"))</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1 border-bottom border-secondary pb-1">
                                        <span><strong>IVA (16.00% Trasladado):</strong></span>
                                        <span>@(((Model.SelectedRecord.Amount / 1.16m) * 0.16m).ToString("C"))</span>
                                    </div>
                                    <div class="d-flex justify-content-between fs-6 fw-bold border-top border-dark pt-2">
                                        <span class="text-simar-green">TOTAL:</span>
                                        <span class="text-simar-green">@Model.SelectedRecord.Amount.ToString("C")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CADENA DIGITAL Y CERTIFICADOS (CFDI REAL) -->
                        <div class="row align-items-center pt-3 border-top border-dark">
                            <div class="col-md-3 text-center border-end border-dark">
                                <!-- SIMULACION DE QR CODE CON ESTILO PREMIUM -->
                                <div class="d-inline-block border border-2 border-dark p-2 bg-light rounded shadow-sm mb-2" style="width: 130px; height: 130px; position: relative;">
                                    <div class="w-100 h-100 d-flex flex-wrap" style="gap: 1px;">
                                        @for(int q=0; q<64; q++) {
                                            <div class="flex-grow-1" style="width: 12%; height: 12%; background-color: @( (q % 3 == 0 || q % 7 == 0 || q < 12 || q > 52) ? "black" : "white" );"></div>
                                        }
                                    </div>
                                    <span class="position-absolute top-50 start-50 translate-middle badge bg-dark p-1 border border-light" style="font-size: 0.55rem; font-family: sans-serif;">CFDI 4.0</span>
                                </div>
                                <p class="mb-0 fw-bold" style="font-size: 0.65rem;">PAC TIMBRADO: FIN1203015JA</p>
                            </div>
                            <div class="col-md-9" style="font-size: 0.68rem; line-height: 1.3;">
                                <div class="mb-2">
                                    <strong class="text-dark">Sello Digital del Emisor:</strong>
                                    <div class="bg-light p-2 border border-secondary rounded font-monospace text-break" style="max-height: 42px; overflow-y: hidden;">
                                        @(Model.FullSelectedInvoice?.FiscalData?.DigitalSealIssuer ?? "T0Y0eCtSUEkwN0lXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0c...")
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <strong class="text-dark">Sello Digital del SAT:</strong>
                                    <div class="bg-light p-2 border border-secondary rounded font-monospace text-break" style="max-height: 42px; overflow-y: hidden;">
                                        @(Model.FullSelectedInvoice?.FiscalData?.DigitalSealSat ?? "T0Y0eCtSUEkwN0lXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0c...")
                                    </div>
                                </div>
                                <div>
                                    <strong class="text-dark">Cadena Original del complemento de certificación digital del SAT:</strong>
                                    <div class="bg-light p-2 border border-secondary rounded font-monospace text-break" style="max-height: 52px; overflow-y: hidden;">
                                        @(Model.FullSelectedInvoice?.FiscalData?.OriginalChain ?? $"||1.1|{(Model.FullSelectedInvoice?.FiscalData?.Uuid ?? "00000000-0000-0000-0000-000000000000")}|{DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss")}|FIN1203015JA|T0Y0eCtSUEkwN0lXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0clpXU3p0c...||")
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between align-items-center bg-light">
                    <div>
                         <span class="badge badge-simar @(Model.SelectedRecord.Status == "Accepted" ? "badge-simar-completada" : (Model.SelectedRecord.Status == "Rejected" ? "badge-simar-cancelada" : "badge-simar-enruta")) fs-6 px-3 py-2">
                             @if (Model.SelectedRecord.Status == "Accepted") { <i class="bi bi-check-lg me-2"></i> }
                             else if (Model.SelectedRecord.Status == "Rejected") { <i class="bi bi-x-lg me-2"></i> }
                             else { <i class="bi bi-clock-history me-2"></i> }
                             CFDI Estado: @(Model.SelectedRecord.Status == "Accepted" ? "Aceptado y Timbrado" : (Model.SelectedRecord.Status == "Rejected" ? "Prefactura Rechazada" : "Prefactura Pendiente"))
                         </span>
                    </div>
                    <div>
                        <a href="/Billing?ActiveTab=@Model.ActiveTab" class="btn btn-simar-outline-gray fw-bold">Cerrar Visualización</a>
                    </div>
                </div>
            </div>
         </div>
    </div>
    <script> document.body.style.overflow = 'hidden'; </script>
}

@if (Model.DisplayedRecords != null)
{
    foreach (var record in Model.DisplayedRecords.Where(r => r.Status == "Pending"))
    {
        <!-- Reject Modal for @record.Id -->
        <div class="modal fade modal-simar" id="rejectModal-@record.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@record.Id" aria-hidden="true" style="z-index: 1060;">
          <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Reject" class="modal-content text-dark h-100 needs-validation" novalidate>
              <input type="hidden" name="id" value="@record.Id" />
              
              <input type="hidden" asp-for="ActiveTab" />
              <div class="modal-header">
                <h5 class="modal-title" id="rejectModalLabel-@record.Id">Rechazar Factura @record.InvoiceNumber</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body text-start flex-grow-1 overflow-auto">
                <p class="mb-3">Por favor, marca las casillas de los campos incorrectos para informar al administrador:</p>
                <div class="row g-2">
                    @{
                        var reasonsList = new List<string> {
                            "RFC Incorrecto", "Razón Social Incorrecta", "Código Postal Incorrecto",
                            "Régimen Fiscal Incorrecto", "Uso de CFDI Incorrecto", "Forma de Pago Incorrecta",
                            "Método de Pago Incorrecto", "Concepto / Servicio Incorrecto", "Monto Total Incorrecto",
                            "Otros"
                        };
                    }
                    @for (int idx = 0; idx < reasonsList.Count; idx++)
                    {
                        var rText = reasonsList[idx];
                        var chkId = $"chk_{record.Id}_{idx}";
                        var isOtros = rText == "Otros";
                        <div class="col-md-6">
                            <label class="form-check d-flex align-items-center p-2 border rounded-3 h-100 m-0 bg-light rounded" for="@chkId">
                                <input class="form-check-input my-0 ms-1 me-3 validate-checkbox @(isOtros ? "chk-otros" : "")" type="checkbox" name="rejectReasons" value="@rText" id="@chkId" data-record-id="@record.Id">
                                <span class="form-check-label text-simar-dark small">@rText</span>
                            </label>
                        </div>
                    }
                    <div class="col-12 mt-2 select-otros-reason-container text-start" id="otrosContainer-@record.Id" style="display: none;">
                        <label class="form-label small fw-semibold text-simar-dark mb-1">Especifique la razón de "Otros" *</label>
                        <textarea class="form-control form-control-simar text-reason-otros text-dark" rows="2" name="customRejectReason" placeholder="Escriba el motivo del rechazo..." id="txtOtros-@record.Id"></textarea>
                        <div class="invalid-feedback">Por favor ingrese la razón del rechazo.</div>
                    </div>
                    <div class="col-12 mt-2 checkbox-feedback text-danger small text-center" style="display: none;">
                        <i class="bi bi-exclamation-circle me-1"></i> Debes seleccionar al menos un motivo de rechazo.
                    </div>
                </div>
              </div>
              <div class="modal-footer bg-light mt-auto">
                <button type="button" class="btn btn-simar-outline-gray" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger rounded-3 fw-medium px-3 py-2">Confirmar Rechazo</button>
              </div>
            </form>
          </div>
        </div>
    }
}

