@page
@model ClienteWeb.Pages.Billing.IndexModel
@{
    ViewData["Title"] = "Gestión de Facturación";
}

<div class="container-fluid-simar mt-4">


    <!-- Main Content -->
    <div class="card-simar mb-4">
        <div class="card-simar-header pb-0 border-bottom-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <ul class="nav nav-tabs border-bottom-0 pb-0">
                @if (Model.Role == "Admin")
                {
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "RecentServices" ? "active fw-bold border-bottom-0 text-simar-green" : "text-secondary")" asp-page="./Index" asp-route-ActiveTab="RecentServices">
                            <i class="bi bi-file-earmark-text me-1"></i> Servicios Recientes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "RejectedInvoices" ? "active fw-bold border-bottom-0 text-simar-green" : "text-secondary")" asp-page="./Index" asp-route-ActiveTab="RejectedInvoices">
                            <i class="bi bi-exclamation-triangle me-1"></i> Prefacturas Rechazadas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "GeneratedInvoices" ? "active fw-bold border-bottom-0 text-simar-green" : "text-secondary")" asp-page="./Index" asp-route-ActiveTab="GeneratedInvoices">
                            <i class="bi bi-receipt me-1"></i> Facturas Generadas
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "PendingInvoices" ? "active fw-bold border-bottom-0 text-simar-green" : "text-secondary")" asp-page="./Index" asp-route-ActiveTab="PendingInvoices">
                            <i class="bi bi-clock-history me-1"></i> Prefacturas Pendientes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ActiveTab == "AcceptedInvoices" ? "active fw-bold border-bottom-0 text-simar-green" : "text-secondary")" asp-page="./Index" asp-route-ActiveTab="AcceptedInvoices">
                            <i class="bi bi-check-circle me-1"></i> Facturas Aceptadas
                        </a>
                    </li>
                }
            </ul>
            @if (Model.Role == "Admin")
            {
                <button type="button" class="btn btn-simar-primary mb-2 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalGenerarAparte">
                    <i class="bi bi-plus-circle"></i> Factura Aparte
                </button>
            }
        </div>
        <div class="card-body p-4 pt-4">

            <!-- Search Bar -->
            <form method="post" asp-page-handler="Search" class="mb-4">
                <input type="hidden" asp-for="Role" />
                <input type="hidden" asp-for="ActiveTab" />
                <div class="row align-items-end g-3">
                    <div class="col-md-@(Model.ActiveTab == "GeneratedInvoices" ? "3" : "5")">
                        <div class="position-relative h-100">
                            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                            <input type="text" class="form-control-simar ps-5 h-100" asp-for="SearchQuery" placeholder="Buscar por RFC, Cliente o Factura...">
                        </div>
                    </div>
                    @if (Model.ActiveTab == "GeneratedInvoices")
                    {
                        <div class="col-md-2">
                            <label class="form-label form-label-simar mb-1 lh-1" style="font-size: 0.85rem;">Estado</label>
                            <select class="form-select form-control-simar px-3" style="height: 38px; border-radius: 8px;" asp-for="StatusFilter">
                                <option value="">Todos</option>
                                <option value="Pending">Pendiente</option>
                                <option value="Accepted">Aceptada</option>
                            </select>
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label form-label-simar mb-1 lh-1" style="font-size: 0.85rem;">Filtrar por Fecha</label>
                        <input type="date" class="form-control-simar" asp-for="DateFilter" max="@DateTime.Now.ToString("yyyy-12-31")">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-simar-primary w-100 h-100 d-flex justify-content-center align-items-center" style="height: 38px;">
                            <i class="bi bi-search me-2"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>

            @if (Model.IsSearchResult)
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="text-simar-green fw-bold mb-0 fs-4">
                        <i class="bi bi-funnel me-2"></i> Resultados de la Búsqueda
                    </h5>
                    <a asp-page="./Index" asp-route-ActiveTab="@Model.ActiveTab" class="btn btn-simar-outline-gray">Limpiar Búsqueda</a>
                </div>
            }

            <div class="row g-4">
                @if (Model.DisplayedRecords != null && Model.DisplayedRecords.Any())
                {
                    foreach (var record in Model.DisplayedRecords)
                    {
                        <div class="col-md-6 col-lg-4 col-xl-3">
                            <div class="card-simar-subtle h-100">
                                <div class="card-body p-4 position-relative d-flex flex-column h-100">
                                    <div class="d-flex justify-content-between align-items-start mb-3 gap-2" style="min-width: 0;">
                                        <h5 class="card-title text-dark fw-semibold text-truncate mb-0 flex-grow-1" style="min-width: 0;" title="@record.ClientName">@record.ClientName</h5>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0" style="max-width: 65%;">
                                            @if (record.RecordType == "Invoice")
                                            {
                                                <span class="badge badge-simar @(record.Status == "Accepted" ? "badge-simar-completada" : (record.Status == "Rejected" ? "badge-simar-cancelada" : "badge-simar-enruta"))" title="@record.InvoiceNumber">
                                                    @if (record.Status == "Accepted") { <i class="bi bi-check-lg me-1"></i> }
                                                    else if (record.Status == "Rejected") { <i class="bi bi-x-lg me-1"></i> }
                                                    else { <i class="bi bi-clock-history me-1"></i> }
                                                    @record.InvoiceNumber
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-simar @(record.Source == "contract" ? "bg-info text-white" : "badge-simar-programada")" title="ID: @record.Id">
                                                    @if (record.Source == "contract") { <i class="bi bi-file-earmark-text me-1"></i> }
                                                    else { <i class="bi bi-tag me-1"></i> }
                                                    ID: @record.Id
                                                </span>
                                            }

                                            @if (Model.Role == "Admin" && record.RecordType == "Invoice" && record.Status == "Pending")
                                            {
                                                <div class="dropdown">
                                                    <button class="btn btn-link text-secondary p-0 border-0" type="button" id="dropdownMenu-@record.Id" data-bs-toggle="dropdown" aria-expanded="false" style="box-shadow: none; line-height: 1;">
                                                        <i class="bi bi-three-dots-vertical fs-5"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="dropdownMenu-@record.Id" style="z-index: 1030;">
                                                        <li>
                                                            <form method="post" asp-page-handler="Accept" class="w-100">
                                                                <input type="hidden" name="id" value="@record.Id" />
                                                                <input type="hidden" asp-for="ActiveTab" />
                                                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 small fw-medium">
                                                                    <i class="bi bi-check-circle text-success"></i> Aceptar Prefactura
                                                                </button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 small fw-medium" data-bs-toggle="modal" data-bs-target="#rejectModal-@record.Id">
                                                                 <i class="bi bi-x-circle text-danger"></i> Rechazar Prefactura
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (record.RecordType == "Invoice" && record.IsModifiedFromContract)
                                    {
                                        <div class="alert alert-warning py-1 px-2 mb-2 rounded border-0 d-flex align-items-center gap-1 w-100" style="font-size: 0.73rem;">
                                            <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0"></i>
                                            <span class="fw-semibold text-warning-emphasis">Modificado de contrato original</span>
                                        </div>
                                    }
                                    <p class="card-text mb-2"><small class="text-muted">RFC:</small> <strong class="text-simar-dark">@record.TaxId</strong></p>
                                    
                                    <p class="card-text mb-2 d-flex align-items-center overflow-hidden">
                                        <small class="text-muted text-nowrap me-2">Servicio:</small> 
                                        <span class="badge bg-secondary badge-simar text-truncate" style="min-width: 0;" title="@(record.ServiceType ?? record.Description)">@(record.ServiceType ?? record.Description)</span>
                                    </p>
                                    @if(!string.IsNullOrEmpty(record.Reason) && record.Status == "Rejected")
                                    {
                                        <p class="card-text mb-2"><small class="text-muted">Motivo:</small> <span class="badge badge-simar badge-simar-cancelada text-wrap text-start lh-sm w-100 border-0"><i class="bi bi-x-lg me-1"></i> @record.Reason</span></p>
                                    }

                                    <p class="card-text mb-3"><small class="text-muted">Fecha:</small> @record.Date.ToString("dd/MM/yyyy")</p>
                                    <h4 class="card-text text-simar-green mt-2 mb-4">@record.Amount.ToString("C")</h4>
                                    
                                    <div class="mt-auto">
                                        @if (Model.Role == "Admin")
                                        {
                                            if (Model.ActiveTab == "RecentServices")
                                            {
                                                <form method="post" asp-page-handler="PrepareModal">
                                                    <input type="hidden" asp-for="SelectedRecordId" value="@record.Id" />
                                                    
                                                    <input type="hidden" asp-for="ActiveTab" />
                                                    <input type="hidden" asp-for="SearchQuery" />
                                                    <input type="hidden" name="modalType" value="Generate" />
                                                    <button type="submit" class="btn btn-simar-primary justify-content-center w-100 mb-2">
                                                        <i class="bi bi-receipt"></i> Generar Prefactura
                                                    </button>
                                                </form>
                                            }
                                            else if (Model.ActiveTab == "RejectedInvoices")
                                            {
                                                <form method="post" asp-page-handler="PrepareModal">
                                                    <input type="hidden" asp-for="SelectedRecordId" value="@record.Id" />
                                                    
                                                    <input type="hidden" asp-for="ActiveTab" />
                                                    <input type="hidden" asp-for="SearchQuery" />
                                                    <input type="hidden" name="modalType" value="Edit" />
                                                    <button type="submit" class="btn btn-simar-outline justify-content-center w-100">
                                                        <i class="bi bi-pencil-fill"></i> Editar Prefactura
                                                    </button>
                                                </form>
                                            }
                                            else if (Model.ActiveTab == "GeneratedInvoices")
                                            {
                                                <div class="mb-2">
                                                    <form method="post" asp-page-handler="PrepareModal" class="w-100">
                                                        <input type="hidden" asp-for="SelectedRecordId" value="@record.Id" />
                                                        
                                                        <input type="hidden" asp-for="ActiveTab" />
                                                        <input type="hidden" asp-for="SearchQuery" />
                                                        <input type="hidden" name="modalType" value="Details" />
                                                        <button type="submit" class="btn btn-simar-outline-gray justify-content-center w-100 d-inline-flex align-items-center gap-2">
                                                            <i class="bi bi-eye"></i> Ver Detalles
                                                        </button>
                                                    </form>
                                                </div>
                                                @if (record.Status == "Accepted") 
                                                {
                                                    <form method="post" asp-page-handler="Download" class="w-100">
                                                        <input type="hidden" name="id" value="@record.Id" />
                                                        
                                                        <input type="hidden" asp-for="ActiveTab" />
                                                        <button type="submit" class="btn btn-simar-primary justify-content-center w-100">
                                                            <i class="bi bi-download"></i> Descargar
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        }
                                        else 
                                        {
                                            <div class="mb-2">
                                                <form method="post" asp-page-handler="PrepareModal" class="w-100">
                                                    <input type="hidden" asp-for="SelectedRecordId" value="@record.Id" />
                                                    
                                                    <input type="hidden" asp-for="ActiveTab" />
                                                    <input type="hidden" asp-for="SearchQuery" />
                                                    <input type="hidden" name="modalType" value="Details" />
                                                    <button type="submit" class="btn btn-simar-outline-gray justify-content-center w-100 mb-2 d-inline-flex align-items-center gap-2">
                                                        <i class="bi bi-eye"></i> Ver Detalles
                                                    </button>
                                                </form>
                                            </div>
                                            
                                            <div>
                                                <form method="post" class="w-100 d-flex justify-content-between gap-2">
                                                    <input type="hidden" name="id" value="@record.Id" />
                                                    
                                                    <input type="hidden" asp-for="ActiveTab" />
                                                    @if (record.Status == "Pending")
                                                    {
                                                        <button type="submit" asp-page-handler="Accept" class="btn btn-simar-primary flex-fill justify-content-center flex-column px-1 py-2 text-center small">
                                                            <i class="bi bi-check-circle mb-1"></i> Aceptar
                                                        </button>
                                                        <button type="button" class="btn btn-outline-danger flex-fill d-inline-flex flex-column align-items-center justify-content-center px-1 py-2" data-bs-toggle="modal" data-bs-target="#rejectModal-@record.Id">
                                                            <i class="bi bi-x-circle mb-1"></i> Rechazar
                                                        </button>
                                                    }
                                                    else if (record.Status == "Accepted")
                                                    {
                                                        <button type="submit" asp-page-handler="Download" class="btn btn-simar-primary justify-content-center w-100">
                                                            <i class="bi bi-download"></i> Descargar
                                                        </button>
                                                    }
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="empty-state-simar">
                            <i class="bi bi-inboxes"></i>
                            <h4>No se encontraron registros</h4>
                            <p class="text-muted mb-0">Intenta cambiar los filtros de búsqueda o categoría.</p>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- Modals Container Edit / Generate -->
@if (Model.ActiveModal == "Generate" || Model.ActiveModal == "Edit")
{
    var isPreInvoice = Model.ActiveModal == "Generate" || Model.SelectedRecord?.Status == "Pending" || Model.SelectedRecord?.Status == "Rejected";
    var documentName = isPreInvoice ? "Prefactura" : "Factura";
    var modalTitle = Model.ActiveModal == "Generate" ? $"Generar {documentName}" : $"Editar {documentName}";
    var iconClass = Model.ActiveModal == "Generate" ? "bi-check-circle-fill" : "bi-save-fill";
    var handler = Model.ActiveModal == "Generate" ? "Generate" : "Edit";
    var bgClass = Model.ActiveModal == "Generate" ? "bg-simar-light" : "bg-warning bg-opacity-10";
    
    <div class="modal-backdrop fade show" style="z-index: 1040;"></div>
    <div class="modal modal-simar fade show d-block" tabindex="-1" role="dialog" style="z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <form method="post" asp-page-handler="@handler" id="@(handler)Form" class="modal-content h-100 needs-validation" novalidate>
                <div class="modal-header">
                    <h4 class="modal-title">
                        <i class="bi bi-clipboard-data me-2"></i> @modalTitle
                    </h4>
                    <a href="/Billing?ActiveTab=@Model.ActiveTab" class="btn-close"></a>
                </div>
                
                <div class="@bgClass px-5 py-4 border-bottom">
                    <div class="row align-items-end">
                        <div class="col-md-8">
                            <small class="text-uppercase fw-bold text-muted">@modalTitle para:</small>
                            <h3 class="mb-0 mt-2 text-simar-dark fw-bold">@Model.SelectedRecord?.ClientName <span class="fs-5 opacity-75 fw-normal">(@Model.SelectedRecord?.TaxId)</span></h3>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <h2 class="mb-0 fw-bold text-simar-green">@(((Model.SelectedRecord?.Amount ?? 0) * 1.16m).ToString("C"))</h2>
                        </div>
                    </div>
                </div>

                @{
                    var reason = Model.SelectedRecord?.Reason ?? "";
                    var isRfcBad = Model.ActiveModal == "Edit" && reason.Contains("RFC");
                    var isNameBad = Model.ActiveModal == "Edit" && reason.Contains("Razón Social");
                    var isPostalBad = Model.ActiveModal == "Edit" && reason.Contains("Código Postal");
                    var isRegimeBad = Model.ActiveModal == "Edit" && reason.Contains("Régimen Fiscal");
                    var isCfdiBad = Model.ActiveModal == "Edit" && reason.Contains("CFDI");
                    var isPayFormBad = Model.ActiveModal == "Edit" && reason.Contains("Forma de Pago");
                    var isPayMethodBad = Model.ActiveModal == "Edit" && reason.Contains("Método de Pago");
                    var isConceptBad = Model.ActiveModal == "Edit" && (reason.Contains("Concepto") || reason.Contains("Servicio") || reason.Contains("Monto"));
                }

                <div class="modal-body modal-scrollable-simar p-5 pt-4 flex-grow-1 overflow-auto">
                    <input type="hidden" asp-for="SelectedRecordId" />
                    
                    <input type="hidden" asp-for="ActiveTab" />
                    <input type="hidden" asp-for="ItemsJson" id="ItemsJson" />
                    <input type="hidden" asp-for="ProductCode" />
                    <input type="hidden" asp-for="UnitCode" />
                    <input type="hidden" asp-for="TaxObject" />
                    <input type="hidden" asp-for="ServiceId" />

                    @if (Model.ActiveModal == "Edit" && !string.IsNullOrEmpty(Model.SelectedRecord?.Reason))
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 p-3">
                            <div class="bg-danger bg-opacity-25 rounded-circle p-2 me-3 text-danger">
                                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1 text-danger">Esta prefactura fue rechazada</h6>
                                <p class="mb-0 small text-dark opacity-75 mb-0">
                                    <strong>Motivos del rechazo:</strong> @Model.SelectedRecord.Reason
                                </p>
                            </div>
                        </div>
                    }

                    @if (isPreInvoice)
                    {
                        <div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 p-3">
                            <div class="bg-warning bg-opacity-25 rounded-circle p-2 me-3">
                                <i class="bi bi-info-circle-fill text-warning fs-4"></i>
                            </div>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Documento sin Validez Fiscal</h6>
                                <p class="mb-0 small text-dark opacity-75">
                                    Este documento es una <strong>Prefactura</strong> informativa. No tiene validez legal ni fiscal hasta que sea revisada y aceptada por un administrador.
                                </p>
                            </div>
                        </div>
                    }
                    
                    <div class="row g-4">
                        <div class="col-12">
                            <div class="card-simar-subtle border-0">
                                <div class="card-body p-4">
                                    <h5 class="card-subtitle mb-4 text-simar-dark fw-bold text-uppercase border-bottom pb-3">
                                        <i class="bi bi-person-vcard text-simar-green me-3"></i>1. Información del Receptor
                                    </h5>
                                    <div class="row g-4">
                                            <div class="col-md-4">
                                                <label class="form-label form-label-simar text-danger @(isRfcBad ? "fw-bold" : "")">RFC *</label>
                                                <input type="text" class="form-control form-control-simar @(isRfcBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="TaxId" required pattern="^[A-Za-zÑñ&]{3,4}[0-9]{6}[A-Za-z0-9]{3}$" minlength="12" maxlength="13" oninput="this.value = this.value.toUpperCase()" title="Un RFC válido consta de 12 a 13 caracteres, formato letras y números (ej. ABC123456T12)" readonly="@(!string.IsNullOrEmpty(Model.TaxId) && !isRfcBad)">
                                                <div class="invalid-feedback">RFC inválido. Letras mayúsculas (3-4), AAMMdd y 3 caracteres finales.</div>
                                                @if(isRfcBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                            <div class="col-md-8">
                                                <label class="form-label form-label-simar text-danger @(isNameBad ? "fw-bold" : "")">Razón Social *</label>
                                                <input type="text" class="form-control form-control-simar @(isNameBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="BillingName" required minlength="3" maxlength="250" title="Ingresa la razón social" readonly="@(!string.IsNullOrEmpty(Model.BillingName) && !isNameBad)">
                                                <div class="invalid-feedback">La razón social es requerida (mín. 3 caracteres).</div>
                                                @if(isNameBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label form-label-simar text-danger @(isPostalBad ? "fw-bold" : "")">Código Postal *</label>
                                                <input type="text" class="form-control form-control-simar @(isPostalBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="PostalCode" required maxlength="5" minlength="5" pattern="\d{5}" title="Debe contener exactamente 5 dígitos numéricos" readonly="@(!string.IsNullOrEmpty(Model.PostalCode) && !isPostalBad)">
                                                <div class="invalid-feedback">Debe contener 5 dígitos.</div>
                                                @if(isPostalBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label form-label-simar text-danger @(isRegimeBad ? "fw-bold" : "")">Régimen Fiscal *</label>
                                                <select class="form-select form-select-simar @(isRegimeBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="FiscalRegime" required>
                                                    <option value="">-- Seleccione --</option>
                                                    <option value="601">601 - General Ley Personas Morales</option>
                                                    <option value="612">612 - Personas Físicas con Actividades</option>
                                                    <option value="626">626 - RESICO</option>
                                                </select>
                                                <div class="invalid-feedback">Selecciona un régimen fiscal.</div>
                                                @if(isRegimeBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label form-label-simar text-danger @(isCfdiBad ? "fw-bold" : "")">Uso de CFDI *</label>
                                                <select class="form-select form-select-simar @(isCfdiBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="CfdiUsage" required>
                                                    <option value="">-- Seleccione --</option>
                                                    <option value="G01">G01 - Adquisición mercancías</option>
                                                    <option value="G03">G03 - Gastos en general</option>
                                                </select>
                                                <div class="invalid-feedback">Selecciona el uso de CFDI.</div>
                                                @if(isCfdiBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <div class="card-simar-subtle border-0">
                                    <div class="card-body p-4">
                                        <h5 class="card-subtitle mb-4 text-simar-dark fw-bold text-uppercase border-bottom pb-3">
                                            <i class="bi bi-wallet2 text-simar-green me-3"></i>2. Atributos de Pago
                                        </h5>
                                        <div class="row g-4">
                                            <div class="col-md-6">
                                                <label class="form-label form-label-simar text-danger @(isPayFormBad ? "fw-bold" : "")">Forma de Pago *</label>
                                                <select class="form-select form-select-simar @(isPayFormBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="PaymentForm" required>
                                                    <option value="">-- Seleccione --</option>
                                                    <option value="01">01 - Efectivo</option>
                                                    <option value="03">03 - Transferencia</option>
                                                    <option value="04">04 - Tarjeta Crédito</option>
                                                    <option value="99">99 - Por definir</option>
                                                </select>
                                                <div class="invalid-feedback">Selecciona una forma de pago.</div>
                                                @if(isPayFormBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label form-label-simar text-danger @(isPayMethodBad ? "fw-bold" : "")">Método de Pago *</label>
                                                <select class="form-select form-select-simar @(isPayMethodBad ? "is-invalid border-danger bg-danger bg-opacity-10" : "")" asp-for="PaymentMethod" required>
                                                    <option value="">-- Seleccione --</option>
                                                    <option value="PUE">PUE - Pago una exhibición</option>
                                                    <option value="PPD">PPD - Pago diferido</option>
                                                </select>
                                                <div class="invalid-feedback">Selecciona un método de pago.</div>
                                                @if(isPayMethodBad) { <div class="invalid-feedback d-block fw-bold"><i class="bi bi-exclamation-triangle"></i> Marcado para corrección</div> }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="card-simar-subtle border-0">
                                    <div class="card-body p-4">
                                        <h5 class="card-subtitle mb-4 text-simar-dark fw-bold text-uppercase border-bottom pb-3">
                                            <i class="bi bi-list-check text-simar-green me-3"></i>3. Conceptos y Totales
                                        </h5>
                                        @if(isConceptBad) {
                                            <div class="alert alert-danger py-2 mb-3 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> Los importes o servicios están marcados para corrección.</div>
                                        }
                                        @if(Model.SelectedRecord?.Amount <= 0) {
                                            <div class="alert alert-danger py-2 mb-3 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> El monto total debe ser mayor a 0 para generar la factura.</div>
                                        }
                                        <div class="table-responsive table-responsive-simar">
                                            <table class="table table-simar mb-0 @(isConceptBad ? "border-danger bg-danger bg-opacity-10" : "")">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Concepto</th>
                                                        <th>Cantidad</th>
                                                        <th>Precio Unitario</th>
                                                        <th>Impuestos (IVA 16%)</th>
                                                        <th>Importe</th>
                                                        <th class="d-none"></th>
                                                    </tr>
                                                </thead>
                                                <tbody id="conceptsTbody">
                                                    <tr class="concept-row">
                                                        <td class="align-middle">
                                                            <input type="text" class="form-control form-control-simar form-control-sm concept-input" required minlength="2" placeholder="Describe el servicio" value="@(Model.SelectedRecord?.ServiceType ?? Model.SelectedRecord?.Description ?? "Servicio")" />
                                                            <div class="invalid-feedback">El concepto es requerido (mín. 2 caracteres).</div>
                                                        </td>
                                                        <td class="align-middle" style="max-width: 80px;">
                                                            <input type="number" class="form-control form-control-simar form-control-sm qty-input" value="1" min="1" step="1" required />
                                                        </td>
                                                        <td class="align-middle" style="min-width: 150px;">
                                                            <div class="input-group input-group-sm">
                                                                <span class="input-group-text">$</span>
                                                                <input type="number" class="form-control form-control-simar amount-input" value="@(Model.SelectedRecord?.Amount ?? 0)" min="0.01" step="0.01" required />
                                                            </div>
                                                            <div class="invalid-feedback">Monto inválido (debe ser > 0).</div>
                                                        </td>
                                                        <td class="align-middle tax-cell">@(((Model.SelectedRecord?.Amount ?? 0) * 0.16m).ToString("C"))</td>
                                                        <td class="align-middle fw-bold total-cell">@(((Model.SelectedRecord?.Amount ?? 0) * 1.16m).ToString("C"))</td>
                                                        <td class="align-middle text-center d-none">
                                                            <button type="button" class="btn btn-sm btn-outline-danger remove-concept-btn" title="Eliminar concepto"><i class="bi bi-trash"></i></button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                                <tfoot>
                                                    <tr class="d-none">
                                                        <td colspan="6" class="border-0 pb-2">
                                                            <button type="button" id="addConceptBtn" class="btn btn-sm btn-simar-outline-gray"><i class="bi bi-plus-circle me-1"></i> Añadir Concepto</button>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="4" class="text-end border-0 pb-1">Subtotal:</th>
                                                        <th class="subtotal-cell pb-1">@((Model.SelectedRecord?.Amount ?? 0).ToString("C"))</th>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="4" class="text-end border-0 py-1">IVA (16%):</th>
                                                        <th class="tax-cell-foot py-1">@(((Model.SelectedRecord?.Amount ?? 0) * 0.16m).ToString("C"))</th>
                                                    </tr>
                                                    <tr>
                                                        <th colspan="4" class="text-end fs-5 text-simar-green border-0 pt-1">Total:</th>
                                                        <th class="fs-5 text-simar-green total-cell-foot pt-1">@(((Model.SelectedRecord?.Amount ?? 0) * 1.16m).ToString("C"))</th>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    @if (isPreInvoice)
                    {
                        <div class="text-center pb-4">
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i> 
                                Al confirmar, se generará una prefactura para revisión. Este documento no tiene validez fiscal (CFDI).
                            </p>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light mt-auto">
                    <a href="/Billing?ActiveTab=@Model.ActiveTab" class="btn btn-simar-outline-gray">Cancelar</a>
                    <button type="submit" class="btn btn-simar-primary" id="confirmSubmitBtn" data-amount="@(Model.SelectedRecord?.Amount ?? 0)">
                        <i class="bi @iconClass"></i> Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script> document.body.style.overflow = 'hidden'; </script>
}
else if (Model.ActiveModal == "Details" && Model.SelectedRecord != null)
{
    var isPreInvoiceDetails = Model.SelectedRecord.Status == "Pending" || Model.SelectedRecord.Status == "Rejected";
    var documentNameDetails = isPreInvoiceDetails ? "Prefactura" : "Factura";
    var trackingSource = Model.SelectedRecord.Source == "contract" ? "Contrato" : "Manifiesto";
    
    <div class="modal-backdrop fade show" style="z-index: 1040;"></div>
    <div class="modal modal-simar fade show d-block" tabindex="-1" role="dialog" style="z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content h-100 border-0 shadow-lg rounded-3">
                <div class="modal-header bg-simar-dark text-white py-3">
                    <h4 class="modal-title fs-5 fw-bold d-flex align-items-center gap-2 m-0 text-white">
                        <i class="bi bi-file-earmark-check-fill text-simar-green"></i> 
                        Vista de CFDI Digital (Formato de Impresión SAT) — @documentNameDetails @Model.SelectedRecord.InvoiceNumber
                    </h4>
                    <a href="/Billing?ActiveTab=@Model.ActiveTab" class="btn-close btn-close-white" style="box-shadow: none;"></a>
                </div>
                <div class="modal-body modal-scrollable-simar p-5 flex-grow-1 overflow-auto bg-white text-dark" style="font-family: 'Courier New', Courier, monospace; font-size: 0.85rem;">
                    
                    @if (isPreInvoiceDetails)
                    {
                        <div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 p-3 font-sans-serif" style="font-family: sans-serif;">
                            <div class="bg-warning bg-opacity-25 rounded-circle p-2 me-3">
                                <i class="bi bi-info-circle-fill text-warning fs-4"></i>
                            </div>
                            <div>
                                <h6 class="alert-heading fw-bold mb-1">Documento sin Validez Fiscal (Solo de Prueba)</h6>
                                <p class="mb-0 small text-dark opacity-75">
                                    Esta es una **Prefactura** informativa del sistema. No es un CFDI timbrado legal hasta ser validado por el administrador y firmado por el PAC.
                                </p>
                            </div>
                        </div>
                    }

                    @if (Model.SelectedRecord.IsModifiedFromContract)
                    {
                        <div class="alert alert-warning border-0 shadow-sm rounded-3 d-flex align-items-center mb-4 p-3 font-sans-serif" style="font-family: sans-serif;">
                            <div class="bg-warning bg-opacity-25 rounded-circle p-2 me-3">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                            </div>
