@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var formatter = new Intl.NumberFormat('es-MX', {
                style: 'currency',
                currency: 'MXN'
            });

            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.forEach(toastEl => {
                var toast = new bootstrap.Toast(toastEl, { delay: 6000 });
                toast.show();
            });

            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    // Checkbox group custom validation
                    var checkboxFeedback = form.querySelector('.checkbox-feedback');
                    var checkboxes = form.querySelectorAll('input[type="checkbox"][name="rejectReasons"]');
                    if (checkboxes.length > 0) {
                        var isChecked = Array.from(checkboxes).some(c => c.checked);
                        if (!isChecked) {
                            checkboxes.forEach(c => c.setCustomValidity("Debes seleccionar al menos un motivo."));
                            if(checkboxFeedback) checkboxFeedback.style.display = 'block';
                        } else {
                            checkboxes.forEach(c => c.setCustomValidity(""));
                            if(checkboxFeedback) checkboxFeedback.style.display = 'none';
                        }
                    }

                    // Submit intercepción para el JSON
                    if (form.id === 'GenerateForm' || form.id === 'EditForm') {
                        var itemsJsonInput = document.getElementById('ItemsJson');
                        var items = [];
                        var rows = form.querySelectorAll('.concept-row');
                        rows.forEach(function(row) {
                            var cInput = row.querySelector('.concept-input');
                            var qInput = row.querySelector('.qty-input');
                            var aInput = row.querySelector('.amount-input');
                            if (cInput && qInput && aInput) {
                                items.push({
                                    Concept: cInput.value,
                                    Quantity: parseInt(qInput.value) || 1,
                                    Amount: parseFloat(aInput.value) || 0
                                });
                            }
                        });
                        if (itemsJsonInput) {
                            itemsJsonInput.value = JSON.stringify(items);
                        }
                    } else if (form.id === 'apartGenerateForm') {
                        var itemsJsonInput = document.getElementById('apartItemsJson');
                        var items = [];
                        var rows = form.querySelectorAll('.concept-row');
                        rows.forEach(function(row) {
                            var cInput = row.querySelector('.concept-input');
                            var qInput = row.querySelector('.qty-input');
                            var aInput = row.querySelector('.price-input');
                            if (cInput && qInput && aInput) {
                                var qty = parseFloat(qInput.value) || 0;
                                var price = parseFloat(aInput.value) || 0;
                                items.push({
                                    Concept: cInput.value,
                                    Quantity: qty,
                                    Amount: qty * price
                                });
                            }
                        });
                        if (itemsJsonInput) {
                            itemsJsonInput.value = JSON.stringify(items);
                        }
                    }

                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    } else if (form.id === 'GenerateForm' || form.id === 'EditForm') {
                        if (form.dataset.isDirty === 'true' && !form.dataset.confirmed) {
                            event.preventDefault();
                            var confirmModal = new bootstrap.Modal(document.getElementById('confirmDirtyModal'));
                            confirmModal.show();
                            
                            document.getElementById('confirmDirtyBtn').onclick = function() {
                                form.dataset.confirmed = 'true';
                                confirmModal.hide();
                                if (typeof form.requestSubmit === 'function') {
                                    form.requestSubmit();
                                } else {
                                    form.submit();
                                }
                            };
                            return;
                        }
                    }
                    form.classList.add('was-validated');
                }, false);

                // Real-time validation and amount check
                var submitBtn = form.querySelector('button[type="submit"]');
                var inputs = form.querySelectorAll('input, select, textarea');
                
                // Initialize initial values for dirty checking
                inputs.forEach(function(input) {
                    if (input.type === 'checkbox' || input.type === 'radio') {
                        input.dataset.initialValue = input.checked;
                    } else {
                        input.dataset.initialValue = input.value;
                    }
                });

                var formatter = new Intl.NumberFormat('es-MX', {
                    style: 'currency',
                    currency: 'MXN'
                });

                var updateCalculations = function() {
                    var globalSubtotal = 0;
                    var rows = form.querySelectorAll('.concept-row');
                    
                    rows.forEach(function(row) {
                        var qtyInput = row.querySelector('.qty-input');
                        var amountInput = row.querySelector('.amount-input');
                        var taxCell = row.querySelector('.tax-cell');
                        var totalCell = row.querySelector('.total-cell');
                        
                        var qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;
                        var price = parseFloat(amountInput ? amountInput.value : 0) || 0;
                        
                        var rowSubtotal = qty * price;
                        var rowIva = rowSubtotal * 0.16;
                        var rowTotal = rowSubtotal + rowIva;
                        
                        globalSubtotal += rowSubtotal;
                        
                        if (taxCell) taxCell.textContent = formatter.format(rowIva);
                        if (totalCell) totalCell.textContent = formatter.format(rowTotal);
                    });

                    var globalIva = globalSubtotal * 0.16;
                    var globalTotal = globalSubtotal + globalIva;
                    
                    var subtotalFoot = form.querySelector('.subtotal-cell');
                    var taxFoot = form.querySelector('.tax-cell-foot');
                    var totalFoot = form.querySelector('.total-cell-foot');
                    
                    if (subtotalFoot) subtotalFoot.textContent = formatter.format(globalSubtotal);
                    if (taxFoot) taxFoot.textContent = formatter.format(globalIva);
                    if (totalFoot) totalFoot.textContent = formatter.format(globalTotal);
                };

                var validateForm = function() {
                    var isValid = form.checkValidity();
                    var isDirty = false;
                    
                    if (form.id === 'GenerateForm' || form.id === 'EditForm') {
                        // Check if any amount <= 0
                        var amounts = form.querySelectorAll('.amount-input');
                        amounts.forEach(function(amountInput) {
                            if (parseFloat(amountInput.value) <= 0) isValid = false;
                        });
                        
                        // Check if concept count changed
                        var currentConceptCount = form.querySelectorAll('.concept-row').length;
                        var initialConceptCount = form.dataset.initialConceptCount ? parseInt(form.dataset.initialConceptCount) : currentConceptCount;
                        if (currentConceptCount !== initialConceptCount) isDirty = true;
                        
                        // Dirty checking inputs
                        var allInputs = form.querySelectorAll('input, select, textarea');
                        allInputs.forEach(function(input) {
                            if (input.dataset.initialValue !== undefined) {
                                if (input.type === 'checkbox' || input.type === 'radio') {
                                    if (input.dataset.initialValue !== String(input.checked)) isDirty = true;
                                } else {
                                    if (input.dataset.initialValue !== String(input.value)) isDirty = true;
                                }
                            }
                        });
                        
                        // Disable if valid but NO changes (ONLY for EditForm)
                        if (form.id === 'EditForm' && isValid && !isDirty) {
                            isValid = false;
                        }
                        
                        form.dataset.isDirty = isDirty;
                    }
                    
                    if (submitBtn) {
                        submitBtn.disabled = !isValid;
                    }
                };
                
                if (form.id === 'GenerateForm' || form.id === 'EditForm') {
                    form.dataset.initialConceptCount = form.querySelectorAll('.concept-row').length;
                }

                var bindInputEvents = function(container) {
                    var innerInputs = container.querySelectorAll('input, select, textarea');
                    innerInputs.forEach(function(input) {
                        input.addEventListener('input', function() {
                            if (input.classList.contains('amount-input') || input.classList.contains('qty-input')) {
                                updateCalculations();
                            }
                            validateForm();
                        });
                        input.addEventListener('change', function() {
                            if (input.classList.contains('amount-input') || input.classList.contains('qty-input')) {
                                updateCalculations();
                            }
                            validateForm();
                        });
                    });
                    
                    var removeBtns = container.querySelectorAll('.remove-concept-btn');
                    removeBtns.forEach(function(btn) {
                        btn.addEventListener('click', function() {
                            var tbody = document.getElementById('conceptsTbody');
                            if (tbody && tbody.querySelectorAll('.concept-row').length > 1) {
                                var row = btn.closest('tr');
                                if (row) {
                                    row.remove();
                                    updateCalculations();
                                    validateForm();
                                }
                            } else {
                                alert("Debe haber al menos un concepto en la factura.");
                            }
                        });
                    });
                };
                
                // Add new concept row
                var addConceptBtn = document.getElementById('addConceptBtn');
                if (addConceptBtn && (form.id === 'GenerateForm' || form.id === 'EditForm')) {
                    addConceptBtn.addEventListener('click', function() {
                        var tbody = document.getElementById('conceptsTbody');
                        if (tbody) {
                            var template = `
                                <tr class="concept-row">
                                    <td class="align-middle">
                                        <input type="text" class="form-control form-control-simar form-control-sm concept-input" required minlength="2" placeholder="Describe el servicio" value="" />
                                        <div class="invalid-feedback">El concepto es requerido.</div>
                                    </td>
                                    <td class="align-middle" style="max-width: 80px;">
                                        <input type="number" class="form-control form-control-simar form-control-sm qty-input" value="1" min="1" step="1" required />
                                    </td>
                                    <td class="align-middle" style="min-width: 150px;">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number" class="form-control form-control-simar amount-input" value="0" min="0.01" step="0.01" required />
                                        </div>
                                        <div class="invalid-feedback">Monto inválido.</div>
                                    </td>
                                    <td class="align-middle tax-cell">$0.00</td>
                                    <td class="align-middle fw-bold total-cell">$0.00</td>
                                    <td class="align-middle text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-concept-btn" title="Eliminar concepto"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            `;
                            tbody.insertAdjacentHTML('beforeend', template);
                            var newRow = tbody.lastElementChild;
                            bindInputEvents(newRow);
                            updateCalculations();
                            validateForm();
                        }
                    });
                }

                // Initial binding
                bindInputEvents(form);
                
                // Initial validation
                if (form.id === 'GenerateForm' || form.id === 'EditForm') {
                    validateForm();
                }
                
                // Add event listeners to checkboxes to hide error as soon as one is clicked
                var checkboxes = form.querySelectorAll('input[type="checkbox"][name="rejectReasons"]');
                checkboxes.forEach(function(chk) {
                    chk.addEventListener('change', function() {
                        var anyChecked = Array.from(checkboxes).some(c => c.checked);
                        if(anyChecked) {
                            checkboxes.forEach(c => c.setCustomValidity(""));
                            var feedback = form.querySelector('.checkbox-feedback');
                            if(feedback) feedback.style.display = 'none';
                        }
                        
                        // "Otros" checkbox toggle logic
                        if (chk.value === 'Otros') {
                            var recordId = chk.dataset.recordId;
                            var container = document.getElementById('otrosContainer-' + recordId);
                            var textarea = document.getElementById('txtOtros-' + recordId);
                            if (chk.checked) {
                                if (container) container.style.display = 'block';
                                if (textarea) {
                                    textarea.setAttribute('required', 'required');
                                    textarea.focus();
                                }
                            } else {
                                if (container) container.style.display = 'none';
                                if (textarea) {
                                    textarea.removeAttribute('required');
                                    textarea.value = '';
                                    textarea.classList.remove('is-invalid');
                                }
                            }
                        }

                        validateForm();
                    });
                });

                // Add real-time validation listener to custom reject textareas
                var textareas = form.querySelectorAll('.text-reason-otros');
                textareas.forEach(function(textarea) {
                    textarea.addEventListener('input', function() {
                        if (textarea.hasAttribute('required') && !textarea.value.trim()) {
                            textarea.classList.add('is-invalid');
                        } else {
                            textarea.classList.remove('is-invalid');
                        }
                        validateForm();
                    });
                });
            });

            // --- FLUX "FACTURA APARTE" ---
            const apartSelectClient = document.getElementById('apartSelectClient');
            const apartSelectContract = document.getElementById('apartSelectContract');
            const apartSelectManifest = document.getElementById('apartSelectManifest');
            const apartContractFolio = document.getElementById('apartContractFolio');
            const apartTaxId = document.getElementById('apartTaxId');
            const apartPostalCode = document.getElementById('apartPostalCode');
            const apartBillingName = document.getElementById('apartBillingName');
            const apartPaymentMethod = document.getElementById('apartPaymentMethod');
            const apartPaymentForm = document.getElementById('apartPaymentForm');
            const apartFiscalRegime = document.getElementById('apartFiscalRegime');
            const apartCfdiUsage = document.getElementById('apartCfdiUsage');
            const apartConceptsTbody = document.getElementById('apartConceptsTbody');
            const apartSubtotalFoot = document.getElementById('apartSubtotalFoot');
            const apartTaxFoot = document.getElementById('apartTaxFoot');
            const apartTotalFoot = document.getElementById('apartTotalFoot');
            const apartItemsJson = document.getElementById('apartItemsJson');
            const apartServiceId = document.getElementById('apartServiceId');
            const apartConfirmSubmitBtn = document.getElementById('apartConfirmSubmitBtn');
            const apartAddConceptBtn = document.getElementById('apartAddConceptBtn');

            let currentManifests = [];

            function updateApartCalculations() {
                let subtotal = 0;
                const rows = apartConceptsTbody.querySelectorAll('.concept-row');
                
                if (rows.length === 0) {
                    if (!apartConceptsTbody.querySelector('.placeholder-row')) {
                        apartConceptsTbody.innerHTML = `
                            <tr class="placeholder-row">
                                <td colspan="6" class="text-center text-muted py-3">Seleccione un cliente y manifiesto, o añada conceptos manualmente.</td>
                            </tr>
                        `;
                    }
                    apartSubtotalFoot.textContent = formatter.format(0);
                    apartTaxFoot.textContent = formatter.format(0);
                    apartTotalFoot.textContent = formatter.format(0);
                    apartConfirmSubmitBtn.disabled = true;
                    return;
                }

                rows.forEach(row => {
                    const qtyInput = row.querySelector('.qty-input');
                    const priceInput = row.querySelector('.price-input');
                    const ivaCell = row.querySelector('.iva-cell');
                    const totalCell = row.querySelector('.total-cell');

                    const qty = parseFloat(qtyInput.value) || 0;
                    const price = parseFloat(priceInput.value) || 0;
                    
                    const rowSubtotal = qty * price;
                    const rowIva = rowSubtotal * 0.16;
                    const rowTotal = rowSubtotal + rowIva;

                    subtotal += rowSubtotal;

                    if (ivaCell) ivaCell.textContent = formatter.format(rowIva);
                    if (totalCell) totalCell.textContent = formatter.format(rowTotal);
                });

                const iva = subtotal * 0.16;
                const total = subtotal + iva;

                apartSubtotalFoot.textContent = formatter.format(subtotal);
                apartTaxFoot.textContent = formatter.format(iva);
                apartTotalFoot.textContent = formatter.format(total);

                checkApartFormValidity();
            }

            function checkApartFormValidity() {
                const form = document.getElementById('apartGenerateForm');
                if (!form) return;
                
                const isFormValid = form.checkValidity();
                
                // Check if we have at least one concept-row
                const rows = apartConceptsTbody.querySelectorAll('.concept-row');
                let hasRows = rows.length > 0;
                
                // Check if any row has an invalid or <= 0 amount
                let areRowsValid = true;
                rows.forEach(row => {
                    const qtyInput = row.querySelector('.qty-input');
                    const priceInput = row.querySelector('.price-input');
                    const conceptInput = row.querySelector('.concept-input');
                    
                    if (qtyInput && priceInput && conceptInput) {
                        const qty = parseFloat(qtyInput.value) || 0;
                        const price = parseFloat(priceInput.value) || 0;
                        const concept = conceptInput.value.trim();
                        
                        if (qty <= 0 || price < 0 || !concept) {
                            areRowsValid = false;
                        }
                    } else {
                        areRowsValid = false;
                    }
                });

                apartConfirmSubmitBtn.disabled = !(isFormValid && hasRows && areRowsValid);
            }

            function addApartConceptRow(concept, qty, price, unit = 'U') {
                // Remove placeholder row if it exists
                const placeholder = apartConceptsTbody.querySelector('.placeholder-row');
                if (placeholder) placeholder.remove();

                const tr = document.createElement('tr');
                tr.className = 'concept-row';
                tr.innerHTML = `
                    <td>
                        <input type="text" class="form-control form-control-sm concept-input" value="${concept}" required placeholder="Concepto / Residuo" />
                    </td>
                    <td>
                        <div class="input-group input-group-sm">
                            <input type="number" class="form-control form-control-sm qty-input text-center" value="${qty}" min="0.001" step="any" required />
                            <span class="input-group-text bg-light text-muted px-2 py-0 border-start-0" style="font-size: 0.75rem;">${unit || 'U'}</span>
                        </div>
                    </td>
                    <td>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted px-2 py-0 border-end-0">$</span>
                            <input type="number" class="form-control form-control-sm price-input text-end" value="${price}" min="0" step="any" required />
                        </div>
                    </td>
                    <td class="align-middle text-end iva-cell">$0.00</td>
                    <td class="align-middle text-end fw-bold total-cell">$0.00</td>
                    <td class="align-middle text-center">
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-apart-concept-btn" title="Eliminar">
                            <i class="bi bi-trash fs-5"></i>
                        </button>
                    </td>
                `;

                apartConceptsTbody.appendChild(tr);

                // Bind listeners to row inputs
                const qtyInput = tr.querySelector('.qty-input');
                const priceInput = tr.querySelector('.price-input');
                const conceptInput = tr.querySelector('.concept-input');
                const removeBtn = tr.querySelector('.remove-apart-concept-btn');

                qtyInput.addEventListener('input', updateApartCalculations);
                priceInput.addEventListener('input', updateApartCalculations);
                conceptInput.addEventListener('input', checkApartFormValidity);
                
                removeBtn.addEventListener('click', function() {
                    tr.remove();
                    updateApartCalculations();
                });

                updateApartCalculations();
            }

            if (apartAddConceptBtn) {
                apartAddConceptBtn.addEventListener('click', function() {
                    addApartConceptRow('', 1, 0, 'U');
                });
            }

            if (apartSelectClient) {
                apartSelectClient.addEventListener('change', async function() {
                    const clientId = this.value;
                    
                    if (apartSelectContract) {
                        apartSelectContract.innerHTML = '<option value="">-- Seleccione un Contrato --</option>';
                        apartSelectContract.disabled = true;
                    }
                    apartSelectManifest.innerHTML = '<option value="">-- Primero seleccione un contrato --</option>';
                    apartSelectManifest.disabled = true;
                    apartContractFolio.value = '';
                    apartTaxId.value = '';
                    apartPostalCode.value = '';
                    apartBillingName.value = '';
                    apartServiceId.value = '';
                    apartItemsJson.value = '';
                    apartConfirmSubmitBtn.disabled = true;
                    
                    apartConceptsTbody.innerHTML = `
                        <tr class="placeholder-row">
                            <td colspan="6" class="text-center text-muted py-3">Seleccione un cliente, contrato y manifiesto para ver el detalle o añadir conceptos.</td>
                        </tr>
                    `;
                    apartSubtotalFoot.textContent = '$0.00';
                    apartTaxFoot.textContent = '$0.00';
                    apartTotalFoot.textContent = '$0.00';

                    if (!clientId) return;

                    const selectedOption = this.options[this.selectedIndex];
                    apartTaxId.value = selectedOption.dataset.rfc || '';
                    apartBillingName.value = selectedOption.dataset.name || '';
                    
                    // Recover CP if we have it, otherwise leave it empty for manual input
                    apartPostalCode.value = selectedOption.dataset.cp || '';

                    try {
                        if (apartSelectContract) {
                            apartSelectContract.innerHTML = '<option value="">Cargando contratos...</option>';
                            const response = await fetch(`/Billing?handler=GetContractsForClient&clientId=${clientId}`);
                            if (!response.ok) throw new Error('Error al cargar contratos');
                            
                            const contracts = await response.json();
                            if (contracts && contracts.error) throw new Error(contracts.error);

                            apartSelectContract.innerHTML = '<option value="">-- Seleccione un Contrato --</option>';
                            if (!contracts || contracts.length === 0) {
                                apartSelectContract.innerHTML = '<option value="">No hay contratos activos para este cliente</option>';
                            } else {
                                contracts.forEach(c => {
                                    const opt = document.createElement('option');
                                    opt.value = c.id;
                                    opt.textContent = `${c.folio} - ${c.status}`;
                                    opt.dataset.folio = c.folio;
                                    apartSelectContract.appendChild(opt);
                                });
                                apartSelectContract.disabled = false;
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        if (apartSelectContract) apartSelectContract.innerHTML = `<option value="">Error: ${error.message}</option>`;
                    }
                    checkApartFormValidity();
                });

                if (apartSelectContract) {
                    apartSelectContract.addEventListener('change', async function() {
                        const contractId = this.value;
                        const clientId = apartSelectClient.value;
                        
                        apartSelectManifest.innerHTML = '<option value="">-- Seleccione un Manifiesto --</option>';
                        apartSelectManifest.disabled = true;
                        apartContractFolio.value = '';
                        apartServiceId.value = '';
                        apartItemsJson.value = '';
                        apartConfirmSubmitBtn.disabled = true;
                        
                        apartConceptsTbody.innerHTML = `
                            <tr class="placeholder-row">
                                <td colspan="6" class="text-center text-muted py-3">Seleccione un manifiesto para ver el detalle.</td>
                            </tr>
                        `;
                        apartSubtotalFoot.textContent = '$0.00';
                        apartTaxFoot.textContent = '$0.00';
                        apartTotalFoot.textContent = '$0.00';

                        if (!contractId || !clientId) return;

                        const selectedOption = this.options[this.selectedIndex];
                        const contractFolio = selectedOption.dataset.folio || '';
                        apartContractFolio.value = contractFolio;

                        try {
                            apartSelectManifest.innerHTML = '<option value="">Cargando manifiestos...</option>';
                            const response = await fetch(`/Billing?handler=GetManifestsForContract&clientId=${clientId}&contractId=${contractId}`);
                            if (!response.ok) throw new Error('Error al cargar manifiestos');
                            
                            currentManifests = await response.json();
                            if (currentManifests && currentManifests.error) throw new Error(currentManifests.error);
                            
                            apartSelectManifest.innerHTML = '<option value="">-- Seleccione un Manifiesto --</option>';
                            if (!currentManifests || currentManifests.length === 0) {
                                apartSelectManifest.innerHTML = '<option value="">No hay manifiestos completados para este contrato</option>';
                            } else {
                                currentManifests.forEach((m, idx) => {
                                    const opt = document.createElement('option');
                                    opt.value = idx;
                                    opt.textContent = `${m.numeroManifiesto} (${m.date}) - ${m.residueType} - ${formatter.format(m.amount)}`;
                                    apartSelectManifest.appendChild(opt);
                                });
                                apartSelectManifest.disabled = false;
                            }
                        } catch (error) {
                            console.error(error);
                            apartSelectManifest.innerHTML = `<option value="">Error: ${error.message}</option>`;
                        }
                        checkApartFormValidity();
                    });
                }

                apartSelectManifest.addEventListener('change', function() {
                    const idx = this.value;
                    if (!idx && idx !== '0') {
                        apartServiceId.value = '';
                        apartItemsJson.value = '';
                        apartConfirmSubmitBtn.disabled = true;
                        apartConceptsTbody.innerHTML = `
                            <tr class="placeholder-row">
                                <td colspan="6" class="text-center text-muted py-3">Seleccione un manifiesto para ver el detalle.</td>
                            </tr>
                        `;
                        apartSubtotalFoot.textContent = '$0.00';
                        apartTaxFoot.textContent = '$0.00';
                        apartTotalFoot.textContent = '$0.00';
                        checkApartFormValidity();
                        return;
                    }

                    const manifest = currentManifests[parseInt(idx)];
                    if (!manifest) return;

                    apartServiceId.value = manifest.manifestId || '';
                    
                    // Recover CP, RFC, and BillingName if they are returned by manifest but currently empty (or recover them anyway)
                    if (manifest.postalCode) apartPostalCode.value = manifest.postalCode;
                    if (manifest.rfc) apartTaxId.value = manifest.rfc;
                    if (manifest.businessName) apartBillingName.value = manifest.businessName;
                    
                    if (manifest.paymentMethod && (manifest.paymentMethod === 'PUE' || manifest.paymentMethod === 'PPD')) {
                        apartPaymentMethod.value = manifest.paymentMethod;
                    }

                    apartConceptsTbody.innerHTML = '';

                    if (manifest.details && manifest.details.length > 0) {
                        manifest.details.forEach(d => {
                            addApartConceptRow(d.residuo, d.cantidad, d.precioUnitario, d.unidad);
                        });
                    } else {
                        addApartConceptRow(manifest.residueType || 'Servicio', 1, parseFloat(manifest.amount) || 0, 'U');
                    }
                });

                // Attach validation listeners for manual editing fields
                ['apartTaxId', 'apartPostalCode', 'apartBillingName', 'apartFiscalRegime', 'apartCfdiUsage', 'apartPaymentForm', 'apartPaymentMethod'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        el.addEventListener('input', checkApartFormValidity);
                        el.addEventListener('change', checkApartFormValidity);
                    }
                });
            }
        });
    </script>
}
