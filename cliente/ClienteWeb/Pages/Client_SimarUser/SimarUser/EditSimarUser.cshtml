@page "/editar/{id}"
@model ClienteWeb.Pages.Client_SimarUser.SimarUser.EditSimarUserModel
@{
    ViewData["Title"] = "Expediente de Usuario SIMAR";
}

<div class="container-fluid-simar mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-simar-dark fw-bold">
                <i class="bi bi-person-lines-fill text-simar-green me-2"></i>Expediente de Usuario
            </h2>
            <p class="text-muted">Visualización y edición del perfil de <strong class="text-simar-dark">@Model.DatosUsuario.UserName</strong></p>
        </div>
        <div>
            <button type="button" id="btnHabilitar" class="btn-simar-outline shadow-sm" onclick="activarEdicion()">
                <i class="bi bi-pencil me-1"></i> Modificar Datos Permitidos
            </button>
            <a href="/dashboard" class="btn-simar-outline-gray ms-2 text-decoration-none shadow-sm">
                <i class="bi bi-arrow-left"></i> Volver al Inicio
            </a>
        </div>
    </div>

    <div class="filter-section-simar shadow-sm p-4 p-md-5">
        <form method="post" id="formEditarExpediente">
            <fieldset id="formCampos" disabled>

                <h6 class="border-bottom-simar pb-2 mb-3 text-simar-dark">
                    <i class="bi bi-shield-lock me-2 text-simar-green"></i>Información de Cuenta
                </h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label-simar">Nombre de usuario</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-at text-muted"></i></span>
                            <input type="text" asp-for="DatosUsuario.UserName" class="form-control-simar bg-light text-muted" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-simar">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope text-muted"></i></span>
                            <input type="email" asp-for="DatosUsuario.Email" class="form-control-simar border-start-0" />
                        </div>
                        <span asp-validation-for="DatosUsuario.Email" class="text-danger small"></span>
                    </div>
                </div>

                <h6 class="border-bottom-simar pb-2 mb-3 text-simar-dark mt-4">
                    <i class="bi bi-file-person me-2 text-simar-green"></i>Datos Personales y Fiscales
                </h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label class="form-label-simar">Nombre Completo</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person text-muted"></i></span>
                            <input type="text" asp-for="DatosUsuario.NombreCompleto" class="form-control-simar border-start-0" />
                        </div>
                        <span asp-validation-for="DatosUsuario.NombreCompleto" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-simar">Género</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-gender-ambiguous text-muted"></i></span>
                            <select asp-for="DatosUsuario.Genero" class="form-select-simar border-start-0">
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <span asp-validation-for="DatosUsuario.Genero" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-simar">CURP</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-fingerprint text-muted"></i></span>
                            <input type="text" asp-for="DatosUsuario.Curp" class="form-control-simar bg-light text-muted text-uppercase" maxlength="18" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-simar">RFC</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-file-earmark-text text-muted"></i></span>
                            <input type="text" asp-for="DatosUsuario.Rfc" class="form-control-simar bg-light text-muted text-uppercase" maxlength="13" readonly />
                        </div>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label-simar">Domicilio</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt text-muted"></i></span>
                            <input type="text" asp-for="DatosUsuario.Direccion" class="form-control-simar border-start-0" />
                        </div>
                        <span asp-validation-for="DatosUsuario.Direccion" class="text-danger small"></span>
                    </div>
                </div>

                <h6 class="border-bottom-simar pb-2 mb-3 text-simar-dark mt-4">
                    <i class="bi bi-briefcase me-2 text-simar-green"></i>Información Específica
                </h6>
                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label-simar">Rol en SIMAR</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge text-muted"></i></span>
                            <input type="hidden" asp-for="DatosUsuario.RolSeleccionado" id="hiddenRol" />
                            <input type="text" value="@Model.DatosUsuario.RolSeleccionado" class="form-control-simar bg-light text-muted border-start-0" readonly />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-simar">Salario Mensual</label>
                        <div class="input-group">
                            <span class="input-group-text text-success fw-bold">$</span>
                            <input type="number" step="0.01" asp-for="DatosUsuario.Salario" class="form-control-simar border-start-0 border-end-0" />
                            <span class="input-group-text">MXN</span>
                        </div>
                        <span asp-validation-for="DatosUsuario.Salario" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-none" id="divDriver">
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label-simar text-warning fw-bold">Número de Licencia</label>
                                <div class="input-group">
                                    <span class="input-group-text border-warning bg-warning bg-opacity-10"><i class="bi bi-card-heading text-warning"></i></span>
                                    <input type="text" asp-for="DatosUsuario.NumLicencia" class="form-control-simar border-warning" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="zonaGuardar" class="mt-5 pt-4 text-end border-top" style="display:none;">
                    <button type="button" class="btn-simar-outline-gray me-2 shadow-sm" onclick="cancelarEdicion()">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-simar-primary px-4 shadow-sm">
                        <i class="bi bi-save me-2"></i>Guardar Cambios
                    </button>
                </div>

            </fieldset>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function verificarRol() {
            const hiddenInput = document.getElementById('hiddenRol');
            if (!hiddenInput) return;

            const rolActual = hiddenInput.value.toLowerCase().trim();
            const divDriver = document.getElementById('divDriver');

            if (rolActual === "driver" || rolActual === "chofer") {
                divDriver.classList.remove('d-none');
            } else {
                divDriver.classList.add('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', verificarRol);

        function activarEdicion() {
            document.getElementById('formCampos').disabled = false;
            document.getElementById('btnHabilitar').classList.add('d-none');
            document.getElementById('zonaGuardar').style.display = 'block';
            document.querySelector('input[type="email"]').focus();
        }

        function cancelarEdicion() {
            document.getElementById('formCampos').disabled = true;
            document.getElementById('btnHabilitar').classList.remove('d-none');
            document.getElementById('zonaGuardar').style.display = 'none';
        }
    </script>
}

@section Styles {
    <style>
        .container-fluid-simar {
            width: 95%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .filter-section-simar {
            background-color: #fff;
            border-radius: 15px;
            border: 1px solid #e9ecef;
        }

        .border-bottom-simar {
            border-bottom: 2px solid #f4f4f4;
        }

        .input-group {
            display: flex;
            flex-wrap: nowrap;
        }

        .input-group-text {
            height: 42px;
            border-radius: 10px 0 0 10px !important;
            background-color: #f8f9fa !important;
            border: 1px solid #ced4da;
            display: flex;
            align-items: center;
        }

        .input-group .form-control-simar:last-child,
        .input-group .form-select-simar:last-child,
        .input-group .input-group-text:last-child {
            border-radius: 0 10px 10px 0 !important;
        }

        .form-control-simar, .form-select-simar {
            height: 42px;
            border-radius: 10px;
            border: 1px solid #ced4da;
            padding: 0.375rem 0.75rem;
            width: 100%;
        }

        .input-group > .form-control-simar,
        .input-group > .form-select-simar {
            position: relative;
            flex: 1 1 auto;
            width: 1%;
            min-width: 0;
            border-radius: 0 10px 10px 0;
        }

        .input-group > .input-group-text:first-child + .form-control-simar:not(:last-child),
        .input-group > .input-group-text:first-child + .form-select-simar:not(:last-child) {
            border-radius: 0;
        }

        .form-control-simar:focus, .form-select-simar:focus {
            border-color: #5aad31;
            outline: none;
            box-shadow: 0 0 0 0.25rem rgba(90, 173, 49, 0.25);
        }

        .form-control-simar[readonly], .form-select-simar[disabled] {
            background-color: #e9ecef !important;
            color: #6c757d;
            cursor: not-allowed;
            border-color: #ced4da;
        }
    </style>
}