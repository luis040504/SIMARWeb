@page
@model ClienteWeb.Pages.Manifest.Generate.SelectClientModel
@{
    ViewData["Title"] = "Nuevo manifiesto";
    var hayManifiestosExistentes = Model.ManifiestosPorContrato.Values.Any(c => c.Rp > 0 || c.Rme > 0);
}

<div class="container mt-4" style="max-width: 900px;">

    <div class="mb-4">
        <h4 class="fw-semibold mb-0" style="color: var(--simar-dark);">
            <i class="bi bi-file-earmark-plus me-2" style="color: var(--simar-green);"></i>
            Nuevo manifiesto
        </h4>
        <p class="text-muted small mb-0">Busca el cliente y selecciona el contrato para generar el manifiesto.</p>
    </div>

    @if (Model.ApiError is not null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1"></i> @Model.ApiError
        </div>
    }

    @* ── Buscador ── *@
    <div class="filter-section-simar mb-4">
        <form method="get">
            <label class="form-label-sm fw-semibold">Buscar por razón social</label>
            <div class="d-flex gap-2">
                <input name="Q"
                       value="@Model.Q"
                       class="form-control form-control-sm"
                       placeholder="Ej. Industrias López..."
                       autofocus />
                <button type="submit" class="btn-simar-primary text-nowrap">
                    <i class="bi bi-search"></i> Buscar
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.ClienteId.HasValue)
                {
                    <a asp-page="/Manifest/Generate/SelectClient" class="btn-simar-outline-gray text-nowrap">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </a>
                }
            </div>
        </form>
    </div>

    @* ── Resultados de búsqueda ── *@
    @if (!string.IsNullOrWhiteSpace(Model.Q) && !Model.ClienteId.HasValue)
    {
        if (Model.ClienteResults.Count == 0)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-1"></i>
                No se encontraron clientes para <strong>"@Model.Q"</strong>.
            </div>
        }
        else
        {
            <p class="text-muted small mb-2">@Model.ClienteResults.Count resultado(s) encontrado(s).</p>
            <div class="table-responsive-simar mb-4">
                <table class="table-simar">
                    <thead>
                        <tr>
                            <th>Razón social</th>
                            <th>Teléfono</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.ClienteResults)
                        {
                            <tr>
                                <td class="fw-semibold">@c.BusinessName</td>
                                <td>@(c.Phone ?? "—")</td>
                                <td class="text-center">
                                    <a asp-page="/Manifest/Generate/SelectClient"
                                       asp-route-clienteId="@c.Id"
                                       class="action-btn ver">
                                        <i class="bi bi-folder2-open"></i> Ver contratos
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ── Cliente seleccionado + contratos ── *@
    @if (Model.ClienteSeleccionado is not null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-building fs-4" style="color: var(--simar-green);"></i>
                    <div>
                        <div class="fw-semibold">@Model.ClienteSeleccionado.BusinessName</div>
                        <div class="text-muted small">
                            @if (!string.IsNullOrWhiteSpace(Model.ClienteSeleccionado.Rfc))
                            {
                                <span class="me-3"><i class="bi bi-card-text me-1"></i>@Model.ClienteSeleccionado.Rfc</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ClienteSeleccionado.Phone))
                            {
                                <span><i class="bi bi-telephone me-1"></i>@Model.ClienteSeleccionado.Phone</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Banner aviso manifiestos existentes ── *@
        @if (hayManifiestosExistentes)
        {
            <div class="alert d-flex align-items-start gap-2 mb-3"
                 style="background: #fff8ed; border: 1px solid #f59e0b; border-left: 4px solid #f59e0b; border-radius: 8px; color: #92400e;">
                <i class="bi bi-exclamation-triangle-fill mt-1" style="color: #f59e0b; flex-shrink:0;"></i>
                <div>
                    <strong>Atención:</strong> Uno o más contratos de este cliente ya tienen manifiestos generados.
                    Verifica antes de crear uno nuevo para evitar duplicados.
                </div>
            </div>
        }

        <h6 class="fw-semibold mb-3" style="color: var(--simar-dark);">
            <i class="bi bi-file-earmark-check me-1"></i> Contratos activos
        </h6>

        @if (Model.ContratosActivos.Count == 0)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-1"></i>
                Este cliente no tiene contratos activos. Solo los contratos con estatus <strong>Activo</strong> pueden generar manifiestos.
            </div>
        }
        else
        {
            @* ── Leyenda del semáforo ── *@
            <div class="d-flex align-items-center gap-3 mb-2 flex-wrap" style="font-size: 0.78rem; color: #6c757d;">
                <span class="fw-semibold" style="color: var(--simar-dark);">
                    <i class="bi bi-circle-half me-1"></i>Semáforo:
                </span>
                <span>
                    <span class="badge badge-simar badge-simar-sin me-1">Sin este tipo</span>
                    El contrato no incluye ese tipo de residuo
                </span>
                <span>
                    <span class="badge badge-simar badge-simar-pendiente me-1">Pendiente</span>
                    Contrato incluye el tipo pero aún sin manifiesto
                </span>
                <span>
                    <span class="badge badge-simar badge-simar-peligroso me-1">N existente(s)</span>
                    Ya hay manifiestos generados — click para verlos
                </span>
            </div>

            <div class="table-responsive-simar">
                <table class="table-simar">
                    <thead>
                        <tr>
                            <th>Folio contrato</th>
                            <th>Vigencia</th>
                            <th class="text-center">
                                RP — Peligrosos
                                <i class="bi bi-info-circle ms-1 text-muted"
                                   style="cursor:pointer; font-size:0.8rem;"
                                   data-bs-toggle="popover"
                                   data-bs-trigger="hover focus"
                                   data-bs-placement="top"
                                   data-bs-html="true"
                                   data-bs-content="<strong>Residuos Peligrosos (RP)</strong><br>Incluye RP y RPBI (biológico-infeccioso).<br><br><span style='color:#adb5bd'>●</span> <b>Sin RP</b> — el contrato no contempla este tipo<br><span style='color:#f59e0b'>●</span> <b>Pendiente</b> — tiene RP pero sin manifiesto generado<br><span style='color:#7b2d2d'>●</span> <b>N existente(s)</b> — ya hay manifiestos RP">
                                </i>
                            </th>
                            <th class="text-center">
                                RME — Especiales
                                <i class="bi bi-info-circle ms-1 text-muted"
                                   style="cursor:pointer; font-size:0.8rem;"
                                   data-bs-toggle="popover"
                                   data-bs-trigger="hover focus"
                                   data-bs-placement="top"
                                   data-bs-html="true"
                                   data-bs-content="<strong>Residuos de Manejo Especial (RME)</strong><br>Residuos inorgánicos y orgánicos de manejo especial.<br><br><span style='color:#adb5bd'>●</span> <b>Sin RME</b> — el contrato no contempla este tipo<br><span style='color:#f59e0b'>●</span> <b>Pendiente</b> — tiene RME pero sin manifiesto generado<br><span style='color:#1a3a5c'>●</span> <b>N existente(s)</b> — ya hay manifiestos RME">
                                </i>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contrato in Model.ContratosActivos)
                        {
                            Model.ManifiestosPorContrato.TryGetValue(contrato.ContratoId, out var counts);
                            var urlRp  = $"/Manifest/Generate/HazardousWaste?clienteId={contrato.ClienteId}&contratoId={contrato.ContratoId}";
                            var urlRme = $"/Manifest/Generate/SpecialWaste?clienteId={contrato.ClienteId}&contratoId={contrato.ContratoId}";
                            <tr>
                                <td class="fw-semibold">@contrato.Folio</td>
                                <td>
                                    @(contrato.ExpirationDate.HasValue
                                        ? contrato.ExpirationDate.Value.ToString("dd/MM/yyyy")
                                        : "—")
                                </td>

                                @* ── Columna RP ── *@
                                <td class="text-center">
                                    @if (contrato.TieneRp == false)
                                    {
                                        <span class="badge badge-simar badge-simar-sin"
                                              title="Este contrato no incluye residuos peligrosos">
                                            <i class="bi bi-dash-circle me-1"></i>Sin RP
                                        </span>
                                    }
                                    else
                                    {
                                        @if (contrato.TieneRp == true && counts.Rp == 0)
                                        {
                                            <span class="badge badge-simar badge-simar-pendiente me-1"
                                                  title="Este contrato incluye RP pero aún no se ha generado el manifiesto">
                                                <i class="bi bi-clock me-1"></i>RP pendiente
                                            </span>
                                        }
                                        @if (counts.Rp > 0)
                                        {
                                            <a asp-page="/Manifest/Consult/Index"
                                               asp-route-filterContratoId="@contrato.ContratoId"
                                               asp-route-filterType="peligroso"
                                               class="badge badge-simar badge-simar-peligroso text-decoration-none me-1"
                                               title="Ver manifiestos RP existentes">
                                                <i class="bi bi-eye me-1"></i>@counts.Rp existente(s)
                                            </a>
                                        }
                                        <button type="button"
                                                class="action-btn rp"
                                                onclick="confirmarNuevo(this)"
                                                data-url="@urlRp"
                                                data-tipo="peligroso"
                                                data-tipo-label="Peligroso (RP)"
                                                data-count="@counts.Rp"
                                                data-folio="@contrato.Folio">
                                            <i class="bi bi-plus"></i> Nuevo RP
                                        </button>
                                    }
                                </td>

                                @* ── Columna RME ── *@
                                <td class="text-center">
                                    @if (contrato.TieneRme == false)
                                    {
                                        <span class="badge badge-simar badge-simar-sin"
                                              title="Este contrato no incluye residuos de manejo especial">
                                            <i class="bi bi-dash-circle me-1"></i>Sin RME
                                        </span>
                                    }
                                    else
                                    {
                                        @if (contrato.TieneRme == true && counts.Rme == 0)
                                        {
                                            <span class="badge badge-simar badge-simar-pendiente me-1"
                                                  title="Este contrato incluye RME pero aún no se ha generado el manifiesto">
                                                <i class="bi bi-clock me-1"></i>RME pendiente
                                            </span>
                                        }
                                        @if (counts.Rme > 0)
                                        {
                                            <a asp-page="/Manifest/Consult/Index"
                                               asp-route-filterContratoId="@contrato.ContratoId"
                                               asp-route-filterType="especial"
                                               class="badge badge-simar badge-simar-especial text-decoration-none me-1"
                                               title="Ver manifiestos RME existentes">
                                                <i class="bi bi-eye me-1"></i>@counts.Rme existente(s)
                                            </a>
                                        }
                                        <button type="button"
                                                class="action-btn rme"
                                                onclick="confirmarNuevo(this)"
                                                data-url="@urlRme"
                                                data-tipo="especial"
                                                data-tipo-label="Especial (RME)"
                                                data-count="@counts.Rme"
                                                data-folio="@contrato.Folio">
                                            <i class="bi bi-plus"></i> Nuevo RME
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    <div class="mt-4 d-flex gap-2">
        <a asp-page="/Manifest/Consult/Index" class="btn-simar-outline-gray">
            <i class="bi bi-arrow-left"></i> Cancelar
        </a>
    </div>

</div>

@* ── Modal confirmación duplicado ── *@
<div class="modal fade" id="modalConfirmarNuevo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 8px 32px rgba(0,0,0,0.15);">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-circle fs-5" style="color: #f59e0b;"></i>
                    <h6 class="modal-title fw-semibold mb-0" style="color: var(--simar-dark);">Manifiesto ya existe</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-1" id="modalMensaje" style="color: #374151;"></p>
                <p class="text-muted small mb-0">Si necesitas generar uno adicional, confirma para continuar.</p>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn-simar-outline-gray" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" class="action-btn" id="btnConfirmarModal" onclick="irAlFormulario()">
                    <i class="bi bi-plus-circle me-1"></i> Sí, generar otro
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Inicializar popovers de Bootstrap
    document.querySelectorAll('[data-bs-toggle="popover"]').forEach(el => {
        new bootstrap.Popover(el, { sanitize: false });
    });

    let _urlPendiente = '';

    function confirmarNuevo(btn) {
        const url   = btn.dataset.url;
        const count = parseInt(btn.dataset.count, 10);
        const label = btn.dataset.tipoLabel;
        const folio = btn.dataset.folio;
        const tipo  = btn.dataset.tipo;

        if (count === 0) {
            window.location.href = url;
            return;
        }

        _urlPendiente = url;

        document.getElementById('modalMensaje').textContent =
            `El contrato ${folio} ya tiene ${count} manifiesto(s) de tipo ${label} generado(s).`;

        const btnConfirmar = document.getElementById('btnConfirmarModal');
        btnConfirmar.className = tipo === 'peligroso' ? 'action-btn rp' : 'action-btn rme';

        const modal = new bootstrap.Modal(document.getElementById('modalConfirmarNuevo'));
        modal.show();
    }

    function irAlFormulario() {
        if (_urlPendiente) window.location.href = _urlPendiente;
    }
</script>
}
